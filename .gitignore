# Dependencies
node_modules/

# Astro build output and generated types
dist/
.astro/

# Cloudflare / wrangler
.wrangler/
.dev.vars
.mf/

# Local screenshot + measurement scratch used during design review
_shots/
.shots/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Secrets / environment — never commit API keys or sender config
.env
.env.*
!.env.example

# Build / type artifacts
*.tsbuildinfo

# Local-only working notes. Deliberately NOT committed and NOT deployed:
# a private backlog of documents the site promises but does not have yet.
# Never un-ignore these to "share quickly" — copy the content out instead.
docs/LOCAL-*.md

# Working material, not product content: planning specs, content-gap maps,
# audit reports, agent handoffs, prototypes. Several of these were committed
# early on and have been un-tracked; the files stay on disk for reference, only
# the tracking stops. Whole directories rather than a per-file list, because
# every session so far has added another planning note to docs/ and a list
# silently lets the next one through.
# If a document ever does need to ship, put it at the repo root — DEPLOYMENT.md
# is there for exactly that reason (three source files point at it) — or
# un-ignore it by name below.
/docs/
/design/
/prototypes/

# Audit & design-review scratch left in the repo ROOT by prior sessions.
# Every helper file we dropped during the spacing-audit / photo-fill work is
# _-prefixed; root-anchored (leading /) so nested source dirs are untouched.
/_*
/.chrome-audit-profile/
/.chrome-*-profile*/
/.chrome-v2-profile/
/.chrome-verify-profile/
/alive.txt
/routes.txt
/scripts-list.txt
/sitemap-check.txt
/browser.txt
/shots.txt
/regress*.txt
/build-*.txt
/preview-*.txt

# Agent handoff notes dropped at the repo ROOT get the same treatment as
# docs/ — working material, not product content. (docs/ itself is already
# fully ignored; this catches one-off files that land beside DEPLOYMENT.md,
# which stays tracked on purpose.)
/CANTON-FAIR-IMAGES-HANDOFF.md

# Agent handoff notes dropped at the repo ROOT get the same treatment as
# docs/ — working material, not product content. (docs/ itself is already
# fully ignored; this catches one-off files that land beside DEPLOYMENT.md,
# which stays tracked on purpose.)
/CANTON-FAIR-IMAGES-HANDOFF.md
