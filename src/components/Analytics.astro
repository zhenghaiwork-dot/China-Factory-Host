---
// Public measurement identifier, not a secret. Override at build time if needed.
const measurementId = import.meta.env.PUBLIC_GA4_ID || 'G-D8CWZQGYSL';
const enabled = /^G-[A-Z0-9]+$/.test(measurementId);
---
{enabled && <div data-analytics-root data-measurement-id={measurementId}>
  <aside class="analytics-choice" data-analytics-choice hidden aria-label="Analytics preferences">
    <p>May we use analytics cookies to understand which pages help our visitors? Your inquiry details are not included. <a href="/privacy/">Privacy</a></p>
    <div><button type="button" data-analytics-accept>Allow analytics</button><button type="button" data-analytics-reject>No thanks</button></div>
  </aside>
</div>}
<script>
  import '../scripts/analytics.js';
</script>
<style>
  .analytics-choice{position:fixed;bottom:20px;left:20px;z-index:1000;width:min(430px,calc(100vw - 40px));padding:20px;background:#fff;color:#252525;border:1px solid #dedede;border-radius:12px;box-shadow:0 6px 30px #00000012;font:14px/1.6 system-ui}
  .analytics-choice[hidden]{display:none}
  .analytics-choice p{margin:0 0 14px;font:inherit}
  .analytics-choice a{text-decoration:underline}
  .analytics-choice div{display:flex;gap:10px;flex-wrap:wrap}
  .analytics-choice button{padding:9px 14px;border:1px solid #ccc;border-radius:6px;background:#fff;color:#252525;font:inherit;cursor:pointer}
  .analytics-choice button:focus-visible{outline:2px solid #252525;outline-offset:3px}
</style>
