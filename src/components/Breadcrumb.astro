---
interface Crumb { href: string; label: string; }
interface Props { crumbs?: Crumb[]; current?: string; }
const { crumbs = [], current = '' } = Astro.props;
---
{
  crumbs.length > 0 && (
    <div class="breadcrumb">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
            <li><span aria-current="page">{current}</span></li>
          </ol>
        </nav>
      </div>
    </div>
  )
}
