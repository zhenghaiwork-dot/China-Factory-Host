---
/* CalendarStrip — an exhibition schedule as one proportional rail.
   Built for /guides/visit-factories-between-canton-fair-phases/ (visual
   refactor, docs/visual-layout-refactor-guide.md §4.2).

   V2 (post-critique, 2026-10-14): the first version drew five rounded,
   filled boxes — the two switch-over windows in a large --accent-100 tint,
   which broke the site's own accent discipline (tokens.css: "accent never
   fills a large area — max fill is a badge") and set a loud template tone
   right after the hero. The grammar now borrows from the /canton-fair/ hub's
   .fair-status__rail: a 10px hairline rail whose segments scale with their
   day counts, the switch-over segments in accent red at badge scale, and
   the readable schedule below as spec-list rows at body size. The dates
   (the facts) live in the rows; the rail is the shape.

   Facts stay page-local on purpose. The /canton-fair/ hub owns its own copy
   of the same organiser dates; if these ever move to a shared data file,
   update both call sites in the same commit so the two pages cannot drift.

   a11y: the rail is aria-hidden decoration (its proportions duplicate the
   ordered rows, which carry the real <time datetime="…"> semantics); the
   rows are an <ol> because the segments have an order; gap vs phase is
   carried by the visible label text as well as the colour, never colour
   alone. */
export interface CalSegment {
  id: string;
  kind: 'phase' | 'gap';
  name: string;
  /** Visible date range, e.g. "15–19 Oct". Year lives in the meta row. */
  dates: string;
  /** ISO 8601 interval, e.g. "2026-10-15/2026-10-19". */
  iso: string;
  /** Day count — drives the rail segment width, so duration stays honest. */
  days: number;
  /** Status line next to the dates ("Exhibition open" / "Switch-over …"). */
  note: string;
}
interface Props {
  year: string;
  /** Shown in the meta row, as plain text — the site references the
      organiser's domain as text everywhere, never as a link. */
  meta: string;
  segments: CalSegment[];
  footnotes?: string[];
}
const { year, meta, segments, footnotes = [] } = Astro.props;
---
<div class="calstrip">
  <div class="calstrip__meta">
    <p class="calstrip__year">{year}</p>
    <p class="calstrip__meta-note">{meta}</p>
  </div>
  <ol class="calstrip__rail" aria-hidden="true">
    {segments.map((s) => (
      <li class:list={['calstrip__seg', `calstrip__seg--${s.kind}`]} style={`--days:${s.days}`} />
    ))}
  </ol>
  <ol class="calstrip__rows clean">
    {segments.map((s) => (
      <li>
        <span class="calstrip__k">{s.name}</span>
        <span class="calstrip__v">
          <time datetime={s.iso}>{s.dates}</time>
          <span class="calstrip__note"> — {s.note}</span>
        </span>
      </li>
    ))}
  </ol>
  {
    footnotes.length > 0 && (
      <ul class="calstrip__notes clean">
        {footnotes.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .calstrip__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-4);
  }
  .calstrip__year {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .calstrip__meta-note {
    margin: 0;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  /* The rail: same grammar as the /canton-fair/ hub's status rail — 10px
     tall, 4px gaps, segment width proportional to the day count. The two
     switch-over segments carry the accent red at exactly badge scale: the
     page's subject is visible at a glance without one large tinted fill. */
  .calstrip__rail {
    display: flex;
    gap: 4px;
    height: 10px;
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .calstrip__seg {
    flex: 1 1 0;
    flex-grow: var(--days);
    min-width: 0;
    border-radius: 2px;
    background: var(--ink-200);
  }
  .calstrip__seg--gap { background: var(--color-accent); }
  /* The schedule itself: spec-list grammar — uppercase label, body-size
     value — so the facts read at the same size as every other list on the
     site instead of a caption-scale box. */
  .calstrip__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink-100);
  }
  .calstrip__rows li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--ink-100);
  }
  .calstrip__k {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .calstrip__v {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    color: var(--text-primary);
  }
  .calstrip__note {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-secondary);
  }
  .calstrip__notes {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: var(--fs-caption);
    color: var(--text-secondary);
  }
  @media (min-width: 768px) {
    .calstrip__notes {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2) var(--space-8);
    }
  }
</style>
