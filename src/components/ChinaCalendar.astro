---
import dates from '../data/china-calendar.json';
const initialDates = dates.filter(d => d.year === 2026 && d.month === 11);
---
<div class="calendar-experience" id="calendar-tool">
<div class="cal-intro"><div><span class="cal-kicker">CALENDAR &amp; TRAVEL PLANNING</span><h1>Chinese calendar<br/>2026–2027<span class="cal-period">.</span></h1><p>Find your lunar date. Understand the holidays.<br/>Choose a better time to visit China.</p></div><aside class="cal-countdown"><span class="cal-kicker">CHINESE NEW YEAR · 6 FEBRUARY 2027</span><strong id="cny-countdown">92</strong><p id="countdown-caption">days to the Year of the Goat</p><small>Counted in China Standard Time · UTC+8</small></aside></div><nav class="calendar-nav" aria-label="Calendar sections"><a href="#calendar-tool">Calendar</a><a href="#dates">Festival dates</a><a href="#holidays">Public holidays</a><a href="#factory">Factory closures</a><a href="#visit">Plan a visit</a><a href="#faq">Questions</a></nav><div class="cal-layout"><div class="cal-board"><div class="cal-toolbar"><div><span class="cal-kicker">EXPLORE THE CALENDAR</span><h2 id="month-label">November 2026</h2></div><div class="cal-controls"><button id="cal-prev" aria-label="Previous month">←</button><button id="cal-today">Today</button><button id="cal-next" aria-label="Next month">→</button></div></div>
<div class="cal-selects"><label>Year <select id="cal-year"><option>2026</option><option>2027</option></select></label><label>Month <select id="cal-month">{Array.from({length:12},(_,m)=><option value={m+1} selected={m===10}>{new Date(2026,m,1).toLocaleString('en',{month:'long'})}</option>)}</select></label><label class="cal-date-search">Go to date <input id="cal-date-input" type="date" min="2026-01-01" max="2027-12-31" aria-describedby="date-input-feedback" /></label></div>
<p id="date-input-feedback" class="cal-input-feedback" aria-live="polite">Dates shown in China Standard Time · UTC+8</p><div class="cal-week" aria-hidden="true">{['MON','TUE','WED','THU','FRI','SAT','SUN'].map(d=><span>{d}</span>)}</div><div id="cal-grid" class="cal-grid" aria-label="Choose a date">{Array.from({length:6},()=> <span class="cal-empty" />)}{initialDates.map(d => <button class="cal-day" type="button" aria-label={`${d.date}, lunar ${d.lunar}`}><strong>{d.day}</strong><small>{d.cn.split("月")[1]}</small><span class="cal-festival">{d.festival}</span></button>)}</div><div class="cal-legend"><span><i class="dot holiday"></i>Public holiday</span><span><i class="dot festival"></i>Festival</span><span><i class="dot adjusted"></i>Adjusted workday</span></div><noscript><p>Enable JavaScript to explore individual days. Festival and holiday tables remain available below.</p></noscript></div>
<aside class="cal-detail" aria-live="polite" aria-atomic="true"><span class="cal-kicker" id="selected-heading">YOUR SELECTED DAY</span><div class="cal-big-date"><strong id="selected-day">06</strong><span id="selected-month">NOVEMBER<br/>2026</span></div><p id="selected-weekday">Friday · China Standard Time</p><div class="cal-lunar"><span id="selected-cn">九月廿八</span><p id="selected-lunar">Lunar month 9 · day 28</p><small id="selected-animal">Year of the Horse</small></div><div id="selected-status" class="cal-status">Regular working day</div><p id="selected-note" class="cal-note">Confirm your supplier’s appointment and production schedule separately.</p><button type="button" id="copy-date" class="cal-copy">Copy date &amp; lunar details</button><span id="copy-feedback" class="cal-input-feedback" aria-live="polite"></span><a href="#visit" class="cal-detail-link">What this means for a factory visit <span>↗</span></a></aside></div>
<div class="cal-quick"><button data-jump="2027-02-06"><span>01 / NEXT LUNAR NEW YEAR</span><strong>06 February 2027 <b>↗</b></strong><small>Welcome the Year of the Goat</small></button><button data-jump="2027-10-01"><span>02 / GOLDEN WEEK</span><strong>01–07 October 2027 <b>↗</b></strong><small>Explore the National Day holiday</small></button><a href="#holidays"><span>03 / PLAN AHEAD</span><strong>Holidays &amp; working days <b>↓</b></strong><small>See the mainland holiday calendar</small></a></div>
<script type="application/json" id="calendar-data" set:html={JSON.stringify(dates)} />
</div>
<script>
type Day={date:string;day:number;month:number;year:number;lunar:string;cn:string;animal:string;holiday:string;festival:string;status:string};
const days:Day[]=JSON.parse(document.querySelector('#calendar-data')!.textContent!);
const el=(id:string)=>document.getElementById(id)!;
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
let selected=days.find(d=>d.date===today)||days[0],year=selected.year,month=selected.month;
function choose(d:Day){selected=d;(el("cal-date-input") as HTMLInputElement).value=d.date;el("copy-feedback").textContent="";el('selected-heading').textContent=d.date===today?'TODAY IN CHINA':'YOUR SELECTED DAY';el('selected-day').textContent=String(d.day).padStart(2,'0');el('selected-month').textContent=new Date(d.date+'T12:00:00Z').toLocaleDateString('en',{month:'long',year:'numeric',timeZone:'UTC'});el('selected-weekday').textContent=new Date(d.date+'T12:00:00Z').toLocaleDateString('en',{weekday:'long',timeZone:'UTC'})+' · China Standard Time';el('selected-cn').textContent=d.cn;el('selected-lunar').textContent='Lunar '+d.lunar;el('selected-animal').textContent='Year of the '+d.animal;
const labels:Record<string,string>={holiday:d.holiday+' · public holiday',adjusted:'Adjusted working day',weekend:'Regular weekend',working:'Regular working day',unverified:'Workday adjustment not verified'};el('selected-status').textContent=d.festival?d.festival+' / '+labels[d.status]:labels[d.status];el('selected-note').textContent=d.status==='holiday'?'A public holiday does not establish every factory’s closure dates. Confirm access before travelling.':d.status==='unverified'?'2027 holiday breaks are listed. Weekend workday adjustments still need verification against the full official notice.':'Confirm your supplier’s appointment, attending staff and production schedule separately.';render();}
function render(){el('month-label').textContent=new Date(Date.UTC(year,month-1,1)).toLocaleDateString('en',{month:'long',year:'numeric',timeZone:'UTC'});(el('cal-year') as HTMLSelectElement).value=String(year);(el('cal-month') as HTMLSelectElement).value=String(month);const grid=el('cal-grid');grid.replaceChildren();const start=(new Date(Date.UTC(year,month-1,1)).getUTCDay()+6)%7;for(let i=0;i<start;i++){let s=document.createElement('span');s.className='cal-empty';grid.append(s);}days.filter(d=>d.year===year&&d.month===month).forEach(d=>{let b=document.createElement('button');b.className='cal-day '+d.status+(d.date===selected.date?' selected':'')+(d.date===today?' is-today':'');b.dataset.date=d.date;b.tabIndex=d.date===selected.date?0:-1;b.setAttribute('aria-pressed',String(d.date===selected.date));b.setAttribute('aria-label',`${d.date}, lunar ${d.lunar}${d.holiday?', '+d.holiday:''}${d.festival?', '+d.festival:''}`);let n=document.createElement('strong');n.textContent=String(d.day);let l=document.createElement('small');l.textContent=d.cn.split("月")[1]||d.cn;let f=document.createElement('span');f.className='cal-festival';f.textContent=d.festival||(d.status==='adjusted'?'Workday':d.holiday?'Holiday':'');b.append(n,l,f);b.onclick=()=>{choose(d);document.querySelector<HTMLButtonElement>(`[data-date="${d.date}"]`)?.focus({preventScroll:true})};b.onkeydown=(event)=>{const offsets:Record<string,number>={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7};if(event.key in offsets){event.preventDefault();const next=days[days.findIndex(x=>x.date===d.date)+offsets[event.key]];if(next){year=next.year;month=next.month;choose(next);document.querySelector<HTMLButtonElement>(`[data-date="${next.date}"]`)?.focus({preventScroll:true})}}};grid.append(b)});(el('cal-prev') as HTMLButtonElement).disabled=year===2026&&month===1;(el('cal-next') as HTMLButtonElement).disabled=year===2027&&month===12;}
function move(delta:number){const t=new Date(Date.UTC(year,month-1+delta,1));year=t.getUTCFullYear();month=t.getUTCMonth()+1;choose(days.find(d=>d.year===year&&d.month===month)!)}
el('cal-prev').onclick=()=>move(-1);el('cal-next').onclick=()=>move(1);el('cal-today').onclick=()=>{const d=days.find(d=>d.date===today);if(d){year=d.year;month=d.month;choose(d)}};(el('cal-today') as HTMLButtonElement).disabled=!days.some(d=>d.date===today);
el('cal-year').onchange=()=>{year=Number((el('cal-year') as HTMLSelectElement).value);choose(days.find(d=>d.year===year&&d.month===month)!)};el('cal-month').onchange=()=>{month=Number((el('cal-month') as HTMLSelectElement).value);choose(days.find(d=>d.year===year&&d.month===month)!)};
el('cal-date-input').onchange=()=>{const d=days.find(x=>x.date===(el('cal-date-input') as HTMLInputElement).value);if(!d){el('date-input-feedback').textContent='Choose a date between 1 January 2026 and 31 December 2027.';return}el('date-input-feedback').textContent='Dates shown in China Standard Time · UTC+8';year=d.year;month=d.month;choose(d)};
el('copy-date').onclick=async()=>{try{await navigator.clipboard.writeText(selected.date+' · China Standard Time (UTC+8) · Lunar '+selected.lunar+' · Year of the '+selected.animal+' · '+el('selected-status').textContent);el('copy-feedback').textContent='Copied. Ready to paste into your trip notes.'}catch{el('copy-feedback').textContent='Copy unavailable. Select the date details above to copy them.'}};
document.querySelectorAll<HTMLButtonElement>('[data-jump]').forEach(b=>b.onclick=()=>{const d=days.find(d=>d.date===b.dataset.jump)!;year=d.year;month=d.month;choose(d);el('calendar-tool').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'})});choose(selected);
</script>
