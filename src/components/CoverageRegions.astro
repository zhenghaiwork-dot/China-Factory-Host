---
const regions = [
  { label: 'Home base', name: 'Zhejiang', cities: ['Hangzhou · HQ', 'Ningbo', 'Yiwu', 'Shaoxing', 'Jinhua'], detail: 'Our base for coordinating factory visits.', href: '/destinations/zhejiang/', link: 'Explore Zhejiang' },
  { label: 'Resident team', name: 'Pearl River Delta', cities: ['Guangzhou', 'Dongguan', 'Shenzhen', 'Foshan', 'Zhongshan'], detail: 'Regional support, confirmed for your visit.', href: '/destinations/guangzhou-dongguan/', link: 'Explore the region' },
  { label: 'By arrangement', name: 'Other regions', cities: ['Qingdao', 'Nanjing', 'Shijiazhuang', 'Xiamen', 'Chengdu'], detail: 'Share your location and dates to check availability.', href: '/contact/', link: 'Check your destination' },
];
---
<div class="coverage-regions" aria-label="Factory visit coverage">
  {regions.map((region, i) => <article class:list={['region-card', { 'region-card--base': i === 0 }]}>
    <p class="region-label">{region.label}</p>
    <h3>{region.name}</h3>
    <p class="region-detail">{region.detail}</p>
    <ul>{region.cities.map(city => <li>{city}</li>)}</ul>
    <a href={region.href}>{region.link}<span aria-hidden="true">→</span></a>
  </article>)}
</div>
<style>
  .coverage-regions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:30px}
  .region-card{display:flex;flex-direction:column;min-width:0;background:#fff;border-radius:12px;padding:28px;box-shadow:0 3px 16px #242c3804}
  .region-label{font-size:.7rem;font-weight:550;color:#7b8491;margin:0 0 14px;line-height:1.5}
  .region-card--base .region-label{color:#b32230}
  .region-card h3{font-size:1.23rem;font-weight:600;letter-spacing:-.025em;line-height:1.3;margin:0 0 14px;color:#303740}
  .region-detail{font-size:.82rem;line-height:1.75;color:#7a8390;margin:0 0 22px;min-height:3.5em}
  ul{list-style:none;padding:0;margin:0 0 27px;display:grid;gap:8px}
  li{font-size:.88rem;color:#505b69;line-height:1.6;margin:0}
  a{display:flex;justify-content:space-between;gap:14px;align-items:center;margin-top:auto;font-size:.77rem;font-weight:550;color:#636f7e;text-decoration:none;padding:5px 0;line-height:1.6}
  a:hover{color:#b32230}a:focus-visible{outline:2px solid #b32230;outline-offset:5px}a span{color:#929ba7}
  @media(max-width:1000px){.region-card{padding:23px}.coverage-regions{gap:15px}.region-card h3{font-size:1.1rem}}
  @media(max-width:760px){.coverage-regions{grid-template-columns:1fr;gap:16px}.region-card{padding:25px}.region-detail{min-height:0;margin-bottom:18px}ul{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 16px;margin-bottom:20px}.region-card h3{font-size:1.22rem}}
</style>
