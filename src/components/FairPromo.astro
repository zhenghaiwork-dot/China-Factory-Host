---
/**
 * FairPromo — TEMPORARY homepage strip pointing at /canton-fair/.
 *
 * Put up 2026-10-14 while the 140th session runs (15 October – 4 November
 * 2026, Pazhou, Guangzhou). It exists to catch the seasonal traffic and hand
 * it to the hub; it is not part of the permanent homepage argument.
 *
 * v2, same day: v1 forgot the .container, so the photograph sat pinned to the
 * viewport edge while every neighbouring band is inset — it read as a broken
 * banner, and the user was right. It is a three-part band now (media / body /
 * link), inside the same container as the claims strip above it.
 *
 * REMOVAL — do this after the fair closes:
 *   1. delete this file
 *   2. delete the import and the <FairPromo /> line in src/pages/index.astro
 * That is all: the styles are scoped here, so nothing is left behind in
 * components.css and no other page references it.
 *
 * The build-time gate below is a backstop, not the plan: it hides the strip
 * on the first build after 5 November 2026. A static build cannot remove
 * itself from an already-deployed dist, so the strip still needs deleting.
 *
 * The frame is Canton Fair photo '02' via CantonFairPhoto — provenance and
 * any credit line live in src/data/canton-fair-photos.ts, not here.
 */
import CantonFairPhoto from './CantonFairPhoto.astro';

const HIDE_AFTER = '2026-11-05T00:00:00+08:00'; // day after Phase 3 closes
const show = Date.now() < Date.parse(HIDE_AFTER);
---

{
  show && (
    <aside class="fair-promo" aria-label="Canton Fair notice">
      <div class="container">
        <a class="fair-promo__link" href="/canton-fair/">
          <span class="fair-promo__media">
            <CantonFairPhoto id="02" sizes="200px" />
          </span>
          <span class="fair-promo__body">
            <span class="fair-promo__eyebrow">Trade shows · Guangzhou</span>
            <span class="fair-promo__title">
              The 140th Canton Fair runs 15 October – 4 November 2026.
            </span>
            <span class="fair-promo__lead">
              Three phases, five exhibition days each. Which one carries your product, and what a
              booth can tell you before you commit to a visit.
            </span>
          </span>
          <span class="fair-promo__cta">
            Canton Fair buyer guide <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </aside>
  )
}

<style>
  /* Scoped on purpose: this component is meant to be deleted whole. */
  .fair-promo {
    background: var(--surface-tint);
    border-block: 1px solid var(--surface-sunken);
  }
  .fair-promo__link {
    display: grid;
    /* Mobile: the photo is a small square thumbnail, not a banner. A full-width
       3:2 frame would make this "small, temporary" strip the tallest thing on
       a 375px screen. */
    grid-template-columns: 88px 1fr;
    grid-template-areas:
      'media body'
      'media cta';
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .fair-promo__media {
    grid-area: media;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--surface-sunken);
  }
  .fair-promo__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fair-promo__body {
    grid-area: body;
    display: grid;
    gap: var(--space-2);
  }
  .fair-promo__eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-600);
  }
  .fair-promo__title {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
  }
  .fair-promo__lead {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .fair-promo__cta {
    grid-area: cta;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--accent-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fair-promo__cta :global(span) {
    text-decoration: none;
    margin-left: 2px;
  }
  .fair-promo__link:hover .fair-promo__cta {
    color: var(--accent-700);
  }
  .fair-promo__link:hover .fair-promo__title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 768px) {
    .fair-promo__link {
      grid-template-columns: 200px 1fr auto;
      grid-template-areas: 'media body cta';
      gap: var(--space-8);
      padding-block: var(--space-6);
    }
    .fair-promo__media {
      aspect-ratio: 3 / 2;
    }
  }
</style>
