---
import type { FinderResult } from '../lib/match-manufacturing-hubs.ts';
interface Props { result: FinderResult; }
const { result } = Astro.props;
---
<div class="hf-result-content">
  <p class="hf-description">{result.product.description}</p>
  <div class="hf-regions">
    {result.recommendations.map((r) => (
      <article class="hf-region">
        <h3>{r.hub.name}</h3>
        <p class="hf-location">{r.hub.chinese} · {r.hub.province}, China</p>
        <dl class="hf-facts">
          <div><dt>Who to look for</dt><dd>{r.role}</dd></div>
          <div><dt>Why start here</dt><dd>{r.reason}</dd></div>
          <div><dt>Useful when</dt><dd>{r.fit}</dd></div>
          <div><dt>Check before choosing</dt><dd>{r.caution}</dd></div>
        </dl>
        <p><a href={r.hub.href}>Explore this region</a></p>
        <details class="hf-evidence">
          <summary>Sources &amp; what they establish</summary>
          <ul>{r.sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.title}</a><p>{s.publisher}. {s.supports}</p><p class="hf-muted">{s.limitation} Reviewed {s.reviewed}.</p></li>)}</ul>
        </details>
      </article>
    ))}
  </div>
  <div class="hf-advice">
    <div><h3>Prepare before contacting suppliers</h3><ul>{result.product.prepare.map((item) => <li>{item}</li>)}</ul></div>
    <div><h3>Questions worth asking</h3><ul>{result.product.questions.map((item) => <li>{item}</li>)}</ul></div>
  </div>
  <p class="hf-boundary">{result.product.boundary}</p>
  <p class="hf-next"><a href={result.product.industryHref}>Read the industry guide</a> · <a href="/about/how-we-vet-factories/">How to verify a factory</a></p>
  <p class="hf-muted">Regional information reviewed {result.product.reviewed}. Confirm supplier details and appointments before travelling.</p>
</div>
