  </svg>
)}
{name === 'chevron' && (
  <svg class:list={[cls]} width={s(12)} height={s(12)} viewBox="0 0 12 12" aria-hidden="true" focusable="false">
    <path d="M2.4,4.4 L6,8 L9.6,4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="butt" stroke-linejoin="miter" />
  </svg>
)}
{name === 'camera' && (
  <svg class:list={[cls]} width={s(32)} height={s(32)} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
