---
/* Icon set — every glyph is inline SVG (no CDN, no icon font).
   Always aria-hidden: the adjacent visible text carries the meaning. */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size, class: cls } = Astro.props;

const s = (d: number) => size ?? d;
const S = {
  stroke: 'currentColor',
  fill: 'none',
  'stroke-linejoin': 'miter',
  'stroke-linecap': 'butt',
} as const;
---
{name === 'check' && (
  <svg class:list={['icon', 'i-check', cls]} width={s(16)} height={s(16)} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M2.5,8.4 L6,11.9 L13.5,4.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="miter" />
  </svg>
)}
{name === 'cross' && (
  <svg class:list={['icon', 'i-cross', cls]} width={s(16)} height={s(16)} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="butt" />
  </svg>
)}
{name === 'warn' && (
  <svg class:list={['icon', 'i-warn', cls]} width={s(18)} height={s(18)} viewBox="0 0 18 18" aria-hidden="true" focusable="false">
    <path d="M9,2 L16.5,15.5 H1.5 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" />
    <path d="M9,6.6 V10.6" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="9" cy="13" r="1.05" fill="currentColor" />
  </svg>
)}
{name === 'arrow' && (
  <svg class:list={[cls]} width={s(14)} height={s(14)} viewBox="0 0 14 14" aria-hidden="true" focusable="false">
