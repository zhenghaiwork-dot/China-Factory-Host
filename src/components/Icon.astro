{name === 'clock' && (
  <svg class:list={[cls]} width={s(22)} height={s(22)} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.6" />
    <path d="M12,7.4 V12 L15.6,14" />
