---
/* ReadinessList — the four conditions that decide whether a time window
   works, as a scannable check rather than four long key/value rows.
   Built for /guides/visit-factories-between-canton-fair-phases/ (visual
   refactor, docs/visual-layout-refactor-guide.md §4.3).

   Each item: the question you need to answer (q), the action that answers
   it (action), and the background fact behind it (note, optional). No
   checkboxes, no "pass" state — nothing here is a verified result, so
   nothing may look like one. A mono index is the only decoration; items
   separate by air, not rules (wps.com reference grammar); desktop runs a
   2×2 grid, phones a single column.

   a11y: an <ol> (the conditions have a checking order); the index is
   aria-hidden because the list already numbers them. */
export interface ReadItem {
  q: string;
  action: string;
  note?: string;
}
interface Props {
  items: ReadItem[];
}
const { items } = Astro.props;
---
<ol class="readiness clean">
  {
    items.map((it, i) => (
      <li class="readiness__item">
        <span class="readiness__n" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="readiness__body">
          <p class="readiness__q">{it.q}</p>
          <p class="readiness__a">{it.action}</p>
          {it.note && <p class="readiness__note">{it.note}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .readiness {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-8);
  }
  .readiness__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }
  .readiness__n {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
    padding-top: 3px;
  }
  .readiness__q {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }
  .readiness__a {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-body-sm);
    color: var(--text-primary);
  }
  .readiness__note {
    margin: 2px 0 0;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  @media (min-width: 768px) {
    .readiness {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-12);
    }
  }
</style>
