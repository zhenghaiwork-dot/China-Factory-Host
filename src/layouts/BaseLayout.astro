---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';
import CTASection from '../components/CTASection.astro';
import { REPLY_TIME_MICRO, SITE, SITE_URL } from '../data/site.ts';
import { SERVICE_SCHEMA } from '../data/service-schema.ts';

export interface Crumb { href: string; label: string; }
interface Props {
  title: string;
  description: string;
  /** dual-track energy switch — design system §6.2 */
  track?: 'creator' | 'buyer' | 'neutral';
  active?: string;
  crumbs?: Crumb[];
  current?: string;
  /** closing CTA; pass false to omit (e.g. the contact page, which ends in the form) */
  cta?: false | {
    eyebrow?: string;
    title: string;
    lead?: string;
    primary: { label: string; href: string };
    secondary?: { label: string; href: string; external?: boolean };
    micro?: string;
    variant?: 'inverse' | 'plain';
    /** split mode — closing band renders a compact inquiry form instead of a button */
    form?: { destination?: string; submitLabel?: string };
  };
  ogImage?: string;
  bodyClass?: string;
  /** Suppress the page's own <link rel=canonical> and ask engines not to index.
      Only for utility pages that must not compete with the real thing — a 404
      declaring itself canonical is a broken signal (it is the page's own URL,
      so it points nowhere useful and was the single anomalous canonical out of
      the site's 54). Canonical is the stronger assertion, so the two must never
      be emitted together. */
  noindex?: boolean;
}

const {
  title,
  description,
  track = 'neutral',
  active = '',
  crumbs = [],
  current = '',
  /* Closing CTA default. Two V3 hard rules are enforced by this shape:
       · no `eyebrow` — §1.1 #7 forbids a mono uppercase label above a section
         heading, and the closing band is a section with an H2. The prop still
         exists on CTASection; pages simply must not pass it.
       · no `secondary` button — §6.6 caps a section (.cta is named explicitly)
         at ONE button. The WhatsApp channel is already permanently reachable
         through .wa-fab / .wa-bar, which are exempt from the budget. */
  cta = {
    title: 'Plan my factory trip.',
    lead: 'Tell us the category, the city and roughly when. You get a straight answer about what is realistic — including when we are not the right people for the job.',
    primary: { label: 'Plan my factory visit', href: '/contact/' },
    /* The site-wide constant, not a retyped sentence: the closing band, the rail
       and the footer must never disagree about response time (critique M2). */
    micro: REPLY_TIME_MICRO,
  },
  ogImage = '/og-default.svg',
  bodyClass,
  noindex = false,
} = Astro.props;

/* Pages pass their own title / lead / primary and deliberately omit `micro`:
   the closing band's promise is REPLY_TIME_MICRO for every page, so the sentence
   exists in exactly one place (critique M2). A page that genuinely needs another
   closing line can still pass one. */
const ctaProps = cta === false ? false : { micro: REPLY_TIME_MICRO, ...cta };

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const og = new URL(ogImage, SITE_URL).href;

/* True only on the home page, which is the only route that renders the hero
   photograph. Checked here rather than passed in from index.astro so the
   preload can never drift from the frontmatter that owns <picture>. */
const IS_HOME = Astro.url.pathname === '/';

/* JSON-LD. Evidence-gating applies here too: Organization carries ONLY what the
   site itself states on its pages — name, url, what the service is, where it
   operates, and the two location facts every page already publishes in the
   footer ("Based in Zhejiang, China · Working nationwide").
   No street address, no phone number, no Unified Social Credit Code: none of
   those are on the site yet, and a schema field we cannot back with a page is
   worse than a missing field, because it is machine-readable fiction. */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  /* Stable graph id, so this node can be referenced (publisher/provider) from
     other schema blocks instead of being re-declared as a second, possibly
     disagreeing Organization. */
  '@id': SITE_URL + '/#organization',
  name: SITE,
  url: SITE_URL,
  logo: new URL(ogImage, SITE_URL).href,
  description:
    'Hosted factory visits in China: verified factory shortlists, on-the-ground escorts and filming coordination for content creators and brand buyers.',
  areaServed: 'China',
  /* Region + country only — the granularity the site actually publishes. */
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Zhejiang',
    addressCountry: 'CN',
  },
};

/* Derived from the same crumbs/current props the visible breadcrumb renders —
   one source of truth, so the visible trail and the machine-readable trail can
   never disagree. */
const trail = [...crumbs, ...(current ? [{ href: Astro.url.pathname, label: current }] : [])];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, SITE_URL).href,
  })),
};

/* Service, for the eight service routes. Looked up by pathname from a single
   table rather than passed per page: those pages are being rewritten in
   parallel by the content build, and this way nothing there has to change.
   Same evidence gate as above — no price, rating, address or phone. */
const service = SERVICE_SCHEMA[Astro.url.pathname];
const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  serviceType: service.serviceType,
  areaServed: 'China',
  provider: {
    /* Points at the graph node declared above instead of re-declaring the
       organization — same reason as @id: one node, one set of facts. */
    '@id': SITE_URL + '/#organization',
    '@type': 'Organization',
    name: SITE,
    url: SITE_URL,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1A1917" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    {/* First-screen image, discovered before CSS. Without this the LCP element
        is found last: CSS has to parse, then the HTML reach the <picture>, then
        the browser pick a candidate. imagesrcset/imagesizes make the preload
        resolve to the SAME candidate the <picture> will choose, so we never pay
        for two downloads; type gates it off entirely for browsers that cannot
        decode AVIF.
        Only the home page has this hero (verified: hero.jpg is referenced from
        src/pages/index.astro only), so every other route skips it — a preload
        for an image that is not there is a guaranteed wasted round trip. */}
    {IS_HOME && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        href="/images/hero-1600.avif"
        imagesrcset="/images/hero-800.avif 800w, /images/hero-1600.avif 1600w"
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {trail.length > 1 && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {service && (
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    )}
    {/* DELIBERATELY NO modulepreload HERE.
        The two module scripts Astro emits per page are
          /_astro/BaseLayout.astro_astro_type_script_index_0_lang.<hash>.js
          /_astro/page.<hash>.js
        Both hashes change whenever their source changes, so a hand-written link
        would silently rot into a permanent 404 on every page load — and a dead
        preload is worse than no preload, because it also spends a request.
        Astro exposes no stable accessor for those URLs from a component, and the
        scripts already sit in <head> inside the first ~2 KB of markup, so the
        browser discovers them in the very first response packet anyway.
        Revisit only if something can supply the emitted URL at build time. */}
    <!-- Behaviour layer. Loaded as a bundled <script> (not a frontmatter import)
         so it never executes during server-side prerendering. -->
    <script>
      import '../scripts/app.js';
    </script>
  </head>
  <body data-track={track} class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header active={active} />

    <Breadcrumb crumbs={crumbs} current={current} />

    <main id="main">
      <slot />
    </main>

    {ctaProps !== false && <CTASection {...ctaProps} />}

    <Footer />

    <WhatsAppBar />
  </body>
</html>
