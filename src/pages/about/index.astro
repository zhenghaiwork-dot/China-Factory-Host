---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import OnsitePhoto from '../../components/OnsitePhoto.astro';
import Checklist from '../../components/Checklist.astro';
import CoverageRegions from '../../components/CoverageRegions.astro';
import Caveat from '../../components/Caveat.astro';
import VetLink from '../../components/VetLink.astro';
import RelatedNav from '../../components/RelatedNav.astro';
import { waLink, HOST_NAME } from '../../data/site.ts';

const title = "About Our Factory Visit Team in China";
const description = "Local support for factory visits in China. Learn about our team, coverage, supplier checks and the services we coordinate.";

const wa = waLink('Hi, I have a question about your team and how the trips work.');
---

<BaseLayout
  title={title}
  description={description}
  track="neutral"
  active="about"
  current="About"
  cta={{
    eyebrow: 'Next step',
    title: 'Talk to our team.',
    lead: 'Ask anything on this page.',
    primary: { label: 'Talk to our team', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <div class="about-page">
  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          <p class="eyebrow">About</p>
          <h1>About Our Factory Visit Team in China</h1>
          <p class="lead hero__lead">
            We support buyers and creators visiting factories in China. Our base is in Zhejiang; coverage and support are confirmed for each trip.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/contact/">Talk to our team</a>
            <a class="btn btn--secondary" href="/about/how-we-vet-factories/"
              >Read the vetting method</a
            >
          </div>
        </div>
        <div class="hero__media">
          <PhotoSlot name="TEAM · ZHEJIANG HQ" variant="media">
            <OnsitePhoto id="08" eager />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="Who you are dealing with" title="Our team and coverage" />
      <div class="prose">
        <p>
          ChinaFactoryHost supports supplier visits, interpreting and factory filming. Our team
          confirms the available support and visit locations for your product and dates.
        </p>
        
        <p>
          Contact <strong>{HOST_NAME}</strong> to discuss the product, suppliers and support you need.
        </p>
      </div>
      <div class="grid--3 u-mt-8">
        <div class="pillar">
          <p class="pillar__n">SUPPORT</p>
          <p class="pillar__t">Trip coordination</p>
          <p class="pillar__d">
            Supplier appointments, interpreting and transport requirements agreed for your trip.
          </p>
        </div>
        <div class="pillar">
          <p class="pillar__n">HEADQUARTERS</p>
          <p class="pillar__t">Zhejiang</p>
          <p class="pillar__d">
            Visits in Zhejiang and other covered regions, with availability confirmed for your dates.
          </p>
        </div>
        <div class="pillar">
          <p class="pillar__n">LANGUAGES</p>
          <p class="pillar__t">English · Mandarin</p>
          <p class="pillar__d">
            Plus site-level dialect help when a conversation needs to happen with someone who
            prefers it.
          </p>
        </div>
      </div>

    </div>
  </Section>

  <!-- Why we do this -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead eyebrow="Why this exists" title="Check suppliers before planning travel" />
      <div class="prose stack">
        <p>
          An online listing does not establish where a product is made. We identify the supplier's
          role and the checks needed for a visit. A <a href="/guides/factory-vs-trading-company-china/">trading company</a>{' '}
          can be a suitable partner when its role and production arrangements are clear.
        </p>
        <p>
          Registration checks can be completed before travel. Production-site checks and technical
          meetings are arranged around the purpose of the visit.
        </p>
        <p>
          Our <a href="/pricing/">fees</a> are agreed with the client. Any optional sourcing commission
          is disclosed separately; we do not take factory commissions.
        </p>
      </div>
    </div>
  </Section>

  <!-- Language & culture -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Language advantage"
        title="Interpreting specifications and decisions"
        lead="Record technical requirements, conditions and unresolved questions clearly."
      />
      <Checklist
        title="What we bridge"
        numbered
        items={[
          'Technical specifics — tolerances, surface finish, defect acceptance — stated as numbers instead of adjectives',
          'Clarify whether an answer is a refusal, a condition or still awaiting confirmation',
          'The difference between a price that is negotiable and a price that has already absorbed the discount',
          'Why a factory may say yes in the room and no in writing, and how to get the real answer on paper',
          'Holiday and shutdown timing that quietly rewrites your lead-time assumptions',
        ]}
      />
    </div>
  </Section>

  <!-- Coverage -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead
        eyebrow="Where we are based"
        title="Where we support factory visits"
        lead="Based in Zhejiang, with regional support confirmed for your product, dates and visit requirements."
      />
      <CoverageRegions />
      <p class="u-mt-6">
        See the <a href="/destinations/">destination guides</a> for local industries and visit planning.
      </p>
    </div>
  </Section>

  <!-- What we don't do -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Straight talking"
        title="What we don't do."
        lead="Listed here rather than left for you to discover halfway through."
      />
      <div class="stack">
        <Caveat
          title="Limits of sourcing support"
          body="Our sourcing support focuses on supplier shortlisting and visits. Any later order-placement support is agreed separately."
          items={[
            'No factory-spreadsheet services delivered remotely for a flat fee',
            'No drop-shipping setup or store management',
            'No acting as your legal representative or contracting party',
            'No holding or forwarding your supplier payments',
          ]}
        />
        <Caveat
          title="We are not inspectors or certifiers"
          body="We can check a certificate number against the issuing registry and flag what we see on the floor. We are not a testing laboratory, a certification body or a social-compliance auditor."
          items={[
            'No issued certificates — none of our reports substitute for one',
            'No full audits of labour practice, financial health or environmental compliance',
            'No guaranteed outcomes for production runs we were not present for',
          ]}
        />
        <Caveat
          title="We are not a travel agency"
          body="We do not resell flights, hotels or packaged tourism, and we add no margin to them."
          items={[
            'You book your own flights, hotels and visa',
            'No sightseeing itineraries — though we will plan transport if you want a free day',
            'No leisure group tours with shopping stops',
          ]}
        />
      </div>
      <p class="u-mt-6">
        See the available support on the <a href="/services/">services page</a>.
      </p>
    </div>
  </Section>

  <!-- Trust cross-link -->
  <Section alternate>
    <div class="container container--md">
      <VetLink
        desc="Five documented checks before any factory goes on an itinerary, including the signals that make us walk away and the limits of what a visit can prove."
      />
    </div>
  </Section>

  <!-- Related -->
  <Section>
    <div class="container">
      <SectionHead eyebrow="Where to next" title="Read the method, or see where we run it." />
      <RelatedNav
        items={[
          { k: 'Method', t: 'How we vet factories', href: '/about/how-we-vet-factories/' },
          { k: 'Services', t: 'What we run today', href: '/services/' },
          { k: 'Destinations', t: 'Where we host visits', href: '/destinations/' },
          { k: 'Contact', t: 'Ask us something specific', href: '/contact/' },
        ]}
      />
    </div>
  </Section>
  </div>
</BaseLayout>
<style is:global>
.about-page {
  color:#30343a;
  .container{max-width:1180px;padding-inline:32px}
  .container--md{max-width:1080px}
  .hero{padding:42px 0 54px;min-height:0}
  .split-7-5{gap:52px;align-items:center}
  h1{font-size:clamp(2.2rem,3.7vw,3.1rem);line-height:1.15;letter-spacing:-.04em;font-weight:650;text-wrap:pretty;max-width:650px}
  .hero .lead{font-size:1.05rem;line-height:1.8;color:#68717d;margin-top:24px;max-width:580px}
  .hero .btn-row{gap:18px;margin-top:28px;align-items:center}
  .hero .btn{font-size:.82rem;min-height:48px;padding:13px 22px;border-radius:7px}
  .hero .btn--secondary{border:0;background:none;padding:10px 0;color:#616b78;text-decoration:underline;text-underline-offset:5px;box-shadow:none}
  .hero__media{min-width:0;border-radius:14px;overflow:hidden}
  .hero__media img{width:100%;height:370px;object-fit:cover}
  .section{padding-block:52px}
  .section-head{margin-bottom:26px;max-width:850px}
  h2{font-size:clamp(1.45rem,2.6vw,1.95rem);line-height:1.3;font-weight:600;letter-spacing:-.025em;text-wrap:pretty}
  h3{line-height:1.4;letter-spacing:-.015em}
  .eyebrow{font-size:.68rem;letter-spacing:.06em;margin-bottom:14px}
  .section-head__lead{font-size:.98rem;line-height:1.8;color:#747d89;max-width:78ch;margin-top:14px}
  .prose{max-width:80ch}
  .prose p{font-size:.96rem;line-height:1.85;color:#626c79;margin-bottom:18px}
  .grid--3{gap:22px;align-items:stretch}
  .pillar{background:#f5f6f9;border:0;border-radius:12px;padding:26px;min-width:0}
  .pillar__n{font-size:.66rem;color:#858d99;letter-spacing:.06em;font-weight:500;line-height:1.5;margin:0 0 13px}
  .pillar__t{font-size:1.15rem;font-weight:600;letter-spacing:-.02em;margin:0 0 12px;line-height:1.4}
  .pillar__d{font-size:.85rem;line-height:1.8;color:#6c7583;margin:0}
  .checklist{background:#f6f7fa;border:0;border-radius:12px;padding:26px 30px;max-width:930px}
  .checklist__title{font-size:.75rem;color:#7d8794;margin-bottom:18px;letter-spacing:.02em}
  .checklist__list{display:grid;gap:0}
  .checklist__list li{padding:14px 0;gap:18px;font-size:.9rem;line-height:1.8;border-bottom:1px solid #e4e8ee;align-items:baseline}
  .checklist__list li:last-child{border-bottom:0;padding-bottom:0}
  .checklist__num{font-size:.76rem;font-weight:500;color:#939ca8;min-width:25px}
  .coverage{margin-top:26px}
  .coverage__canvas{background:white;border-radius:12px;padding:20px}
  .coverage .legend{gap:16px 24px;margin-top:20px}
  .legend__item{font-size:.76rem;line-height:1.6}
  .tier-card{border-radius:10px;box-shadow:none}
  .caveat{padding:26px 30px;background:#f5f6f9;border:0;border-radius:12px;margin:0}
  .caveat__eyebrow{display:none}
  .caveat__title{font-size:1.12rem;margin-bottom:13px;font-weight:600}
  .caveat__body{font-size:.9rem;line-height:1.8;color:#66717e;max-width:85ch}
  .caveat__list{margin-top:18px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 32px}
  .caveat__list li{font-size:.83rem;line-height:1.8;color:#77818d;margin:0;min-width:0}
  .stack:has(>.caveat){gap:18px}
  p.u-mt-6{font-size:.86rem;color:#727c89;line-height:1.8}
  .related-nav{gap:16px}
  .related-nav a{background:#f5f6f9;border:0;border-radius:10px;padding:24px;box-shadow:none}
  .related-nav a:hover{background:#edf0f6;transform:none}
  .related-nav__k{font-size:.67rem;color:#8a939f;letter-spacing:.04em}
  .related-nav__t{font-size:.95rem;font-weight:550;line-height:1.55;margin-top:10px}
  @media(max-width:900px){
    .split-7-5{gap:28px}.hero__media img{height:320px}
    .grid--3{gap:16px}.pillar{padding:22px}.pillar__t{font-size:1.05rem}
  }
  @media(max-width:700px){
    .container,.container--md{padding-inline:20px}
    .hero{padding:28px 0 36px}.split-7-5{grid-template-columns:1fr;gap:30px}
    h1{font-size:2.1rem;line-height:1.18}.hero .lead{font-size:.97rem;line-height:1.8}
    .hero .btn-row{gap:14px 20px}.hero__media img{height:260px}
    .section{padding-block:36px}.section-head{margin-bottom:22px}
    .grid--3{grid-template-columns:1fr;gap:14px}.pillar{padding:23px}
    .prose p{font-size:.91rem}.section-head__lead{font-size:.92rem}
    .checklist,.caveat{padding:22px}.checklist__list li{font-size:.86rem;gap:12px}
    .caveat__list{grid-template-columns:1fr;gap:10px}.caveat__body{font-size:.86rem}
    .coverage__canvas{padding:8px}.related-nav{grid-template-columns:1fr}
    .related-nav a{padding:20px 22px}.related-nav__t{font-size:.91rem}
  }
}
</style>
<style is:global>
  .about-page .hero .split-7-5 { grid-template-areas:none; align-items:center; gap:40px 52px; }
  .about-page .hero .split-7-5 > div:first-child { display:block; }
  .about-page .hero .split-7-5 > .hero__media { grid-area:auto; align-self:center; margin-top:0; }
  .about-page .hero .split-7-5 > .hero__media .photo-slot { aspect-ratio:auto; }
  .about-page .hero h1 { max-width:650px; font-size:clamp(2.2rem,3.7vw,3.1rem); margin-bottom:0; }
  .about-page .section-head > .lead { font-size:.98rem; line-height:1.8; color:#747d89; margin-top:14px; }
  @media(max-width:900px){ .about-page .hero .split-7-5 { gap:30px; } }
  @media(max-width:700px){ .about-page .hero h1 { font-size:2.1rem; } .about-page .section-head > .lead { font-size:.92rem; } }
</style>
