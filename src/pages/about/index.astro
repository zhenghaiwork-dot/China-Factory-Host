---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import OnsitePhoto from '../../components/OnsitePhoto.astro';
import Checklist from '../../components/Checklist.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import Caveat from '../../components/Caveat.astro';
import NoteStrip from '../../components/NoteStrip.astro';
import VetLink from '../../components/VetLink.astro';
import RelatedNav from '../../components/RelatedNav.astro';
import { waLink, HOST_NAME } from '../../data/site.ts';

const title = "About Our Factory Visit Team in China";
const description = "Local support for factory visits in China. Learn about our team, coverage, supplier checks and the services we coordinate.";

const wa = waLink('Hi, I have a question about your team and how the trips work.');
---

<BaseLayout
  title={title}
  description={description}
  track="neutral"
  active="about"
  current="About"
  cta={{
    eyebrow: 'Next step',
    title: 'Talk to our team.',
    lead: 'Ask anything on this page.',
    primary: { label: 'Talk to our team', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          <p class="eyebrow">About</p>
          <h1>About Our Factory Visit Team in China</h1>
          <p class="lead hero__lead">
            We support buyers and creators visiting factories in China. Our base is in Zhejiang; coverage and support are confirmed for each trip.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/contact/">Talk to our team</a>
            <a class="btn btn--secondary" href="/about/how-we-vet-factories/"
              >Read the vetting method</a
            >
          </div>
        </div>
        <div class="hero__media">
          <PhotoSlot name="TEAM · ZHEJIANG HQ" variant="media">
            <OnsitePhoto id="08" eager />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="Who you are dealing with" title="Our team and coverage" />
      <div class="prose">
        <p>
          ChinaFactoryHost supports supplier visits, interpreting and factory filming. Our team
          confirms the available support and visit locations for your product and dates.
        </p>
        
        <p>
          Contact <strong>{HOST_NAME}</strong> to discuss the product, suppliers and support you need.
        </p>
      </div>
      <div class="grid--3 u-mt-8">
        <div class="pillar">
          <p class="pillar__n">SUPPORT</p>
          <p class="pillar__t">Trip coordination</p>
          <p class="pillar__d">
            Supplier appointments, interpreting and transport requirements agreed for your trip.
          </p>
        </div>
        <div class="pillar">
          <p class="pillar__n">HEADQUARTERS</p>
          <p class="pillar__t">Zhejiang</p>
          <p class="pillar__d">
            Visits in Zhejiang and other covered regions, with availability confirmed for your dates.
          </p>
        </div>
        <div class="pillar">
          <p class="pillar__n">LANGUAGES</p>
          <p class="pillar__t">English · Mandarin</p>
          <p class="pillar__d">
            Plus site-level dialect help when a conversation needs to happen with someone who
            prefers it.
          </p>
        </div>
      </div>
      <div class="u-mt-6">
        {/* Label was "Placeholder" — a note about our own draft status. The body
            is visitor-facing and stays; the marker moves to an attribute. */}
        <NoteStrip label="Team bios" marker="case"
          >Team names, roles and photographs are pending written sign-off from everyone involved. We
          are not publishing bios until they have read them.</NoteStrip
        >
      </div>
    </div>
  </Section>

  <!-- Why we do this -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead eyebrow="Why this exists" title="Check suppliers before planning travel" />
      <div class="prose stack">
        <p>
          An online listing does not establish where a product is made. We identify the supplier's
          role and the checks needed for a visit. A <a href="/guides/factory-vs-trading-company-china/">trading company</a>{' '}
          can be a suitable partner when its role and production arrangements are clear.
        </p>
        <p>
          Registration checks can be completed before travel. Production-site checks and technical
          meetings are arranged around the purpose of the visit.
        </p>
        <p>
          Our <a href="/pricing/">fees</a> are agreed with the client. Any optional sourcing commission
          is disclosed separately; we do not take factory commissions.
        </p>
      </div>
    </div>
  </Section>

  <!-- Language & culture -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Language advantage"
        title="Interpreting specifications and decisions"
        lead="Record technical requirements, conditions and unresolved questions clearly."
      />
      <Checklist
        title="What we bridge"
        numbered
        items={[
          'Technical specifics — tolerances, surface finish, defect acceptance — stated as numbers instead of adjectives',
          'Clarify whether an answer is a refusal, a condition or still awaiting confirmation',
          'The difference between a price that is negotiable and a price that has already absorbed the discount',
          'Why a factory may say yes in the room and no in writing, and how to get the real answer on paper',
          'Holiday and shutdown timing that quietly rewrites your lead-time assumptions',
        ]}
      />
    </div>
  </Section>

  <!-- Coverage -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead
        eyebrow="Where we are based"
        title="Home base, resident team, and the rest."
        lead="We do not claim the same depth everywhere. Tier 1 is home, Tier 2 is staffed, Tier 3 is reachable with notice."
      />
      <CoverageMap />
      <p class="u-mt-6">
        The depth we claim in each region is written on the <a href="/destinations/">destination pages</a>, tier by tier.
      </p>
    </div>
  </Section>

  <!-- What we don't do -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Straight talking"
        title="What we don't do."
        lead="Listed here rather than left for you to discover halfway through."
      />
      <div class="stack">
        <Caveat
          title="Limits of sourcing support"
          body="Our sourcing support focuses on supplier shortlisting and visits. Any later order-placement support is agreed separately."
          items={[
            'No factory-spreadsheet services delivered remotely for a flat fee',
            'No drop-shipping setup or store management',
            'No acting as your legal representative or contracting party',
            'No holding or forwarding your supplier payments',
          ]}
        />
        <Caveat
          title="We are not inspectors or certifiers"
          body="We can check a certificate number against the issuing registry and flag what we see on the floor. We are not a testing laboratory, a certification body or a social-compliance auditor."
          items={[
            'No issued certificates — none of our reports substitute for one',
            'No full audits of labour practice, financial health or environmental compliance',
            'No guaranteed outcomes for production runs we were not present for',
          ]}
        />
        <Caveat
          title="We are not a travel agency"
          body="We do not resell flights, hotels or packaged tourism, and we add no margin to them."
          items={[
            'You book your own flights, hotels and visa',
            'No sightseeing itineraries — though we will plan transport if you want a free day',
            'No leisure group tours with shopping stops',
          ]}
        />
      </div>
      <p class="u-mt-6">
        See the available support on the <a href="/services/">services page</a>.
      </p>
    </div>
  </Section>

  <!-- Trust cross-link -->
  <Section alternate>
    <div class="container container--md">
      <VetLink
        desc="Five documented checks before any factory goes on an itinerary, including the signals that make us walk away and the limits of what a visit can prove."
      />
    </div>
  </Section>

  <!-- Related -->
  <Section>
    <div class="container">
      <SectionHead eyebrow="Where to next" title="Read the method, or see where we run it." />
      <RelatedNav
        items={[
          { k: 'Method', t: 'How we vet factories', href: '/about/how-we-vet-factories/' },
          { k: 'Services', t: 'What we run today', href: '/services/' },
          { k: 'Destinations', t: 'Where we host visits', href: '/destinations/' },
          { k: 'Contact', t: 'Ask us something specific', href: '/contact/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>
