---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import OnsitePhoto from '../../components/OnsitePhoto.astro';
import FAQ from '../../components/FAQ.astro';
import Caveat from '../../components/Caveat.astro';
import RelatedNav from '../../components/RelatedNav.astro';
import { waLink, SITE_URL } from '../../data/site.ts';

const title = "Canton Fair Buyer Guide and Factory Visit Planning";
const description =
  'The 140th Canton Fair runs 15 October to 4 November 2026 in three phases at Pazhou, Guangzhou. Where the fair is today, what it can and cannot tell you, and the seven guides for before, during and after it.';

const wa = waLink('Hi, I am going to Canton Fair and want to add factory visits after it.');

/* The 140th session, autumn 2026. Dates and phase themes are the organiser's
   (Ministry of Commerce notice + cantonfair.org.cn); if an organiser moves
   them, the honest move is to say so and send the reader to the source.

   `days` drives the width of each rail segment, so the rail is a scale
   drawing of the session rather than three equal blocks. */
const phases = [
  {
    no: 1,
    days: 5,
    from: '2026-10-15',
    to: '2026-10-19',
    dates: 'Phase 1 · 15–19 October 2026',
    theme: 'Advanced manufacturing — appliances and consumer electronics, industrial automation and machinery, vehicles and parts, lighting, hardware and tools.',
  },
  {
    no: 2,
    days: 5,
    from: '2026-10-23',
    to: '2026-10-27',
    dates: 'Phase 2 · 23–27 October 2026',
    theme: 'Quality home life — ceramics and kitchenware, household goods, glass and handicrafts, gifts and festival items, building and decorative materials, furniture.',
  },
  {
    no: 3,
    days: 5,
    from: '2026-10-31',
    to: '2026-11-04',
    dates: 'Phase 3 · 31 October – 4 November 2026',
    theme: 'Better living — toys, apparel, textiles and fabrics, shoes and bags, home textiles, stationery, food, sports and leisure.',
  },
];

/* The hub's actual job: one directory, grouped by where the reader is in the
   process. Every guide on the site that belongs to this fair is here, and
   nothing is listed twice. */
const guides = [
  { stage: 'Before', t: 'Is Canton Fair worth it for small buyers? — fair vs Alibaba, 1688 and Yiwu', href: '/guides/is-canton-fair-worth-it-for-small-buyers/' },
  { stage: 'Before', t: 'MOQ for small buyers — eight levers, and what to say at the booth', href: '/guides/canton-fair-moq-for-small-buyers/' },
  { stage: 'Before', t: 'Practical tips — hotels, interpreters, what to carry', href: '/guides/canton-fair-practical-tips-hotels-interpreters/' },
  { stage: 'During', t: 'Verify Canton Fair suppliers — seven checks before you pay a deposit', href: '/guides/verify-canton-fair-suppliers/' },
  { stage: 'During', t: 'Visiting factories between phases — what fits into the three-day gaps', href: '/guides/visit-factories-between-canton-fair-phases/' },
  { stage: 'After', t: 'From Canton Fair to factory visits — shortlist, confirm, visit, compare', href: '/guides/canton-fair-to-factory-visits/' },
  { stage: 'After', t: 'Canton Fair to Zhejiang — fifteen clusters, which town makes what', href: '/destinations/zhejiang/canton-fair-to-zhejiang-factory-visits/' },
];

const whatItCannot = [
  { k: 'Who actually makes the product', v: 'A booth proves a company sells; it does not prove it manufactures. Exhibitors include factories, trading companies and mixed models.' },
  { k: 'Which legal entity you will sign with', v: 'The brand on the booth is often not the name on the contract. Only the licence and the registry record settle it.' },
  { k: 'Whether the floor exists', v: 'Equipment, raw materials, semi-finished goods and the finished-goods warehouse are on the factory floor, not in a hall.' },
  { k: 'Whether the bank account matches', v: 'Payment details are a document check, and it is the one that costs the most when it is skipped.' },
];

const faqs = [
  {
    q: 'Do I need to attend all three phases?',
    a: [
      'No. Each phase covers different categories, so attend the phase that holds your product. The halls close for switch-over between phases (20–22 October and 28–30 October 2026), which is often the best window for factory visits because suppliers are free of their booths. What three days can hold is worked through in the guide on visiting factories between phases.',
    ],
  },
  {
    q: 'Can I visit factories during the fair?',
    a: [
      'Yes, and it is usually easier during the switch-over days than during a phase. Many factories are 30–60 minutes from the Pazhou complex. Treat the fair as the filter and the factory days as the decision.',
    ],
  },
  {
    q: 'Is every Canton Fair exhibitor a real factory?',
    a: [
      'No. The exhibitor list includes factories, trading companies and mixed models. Appearing at the fair does not prove a company makes everything on its stand — the seven-step check in our verification guide is what settles it.',
    ],
  },
  {
    q: 'How many days should I add after the fair?',
    a: [
      'Allow around two working days for four visits within one cluster. Travel time, technical discussions and supplier availability may reduce that number.',
    ],
  },
];

/* A hub is a directory, so it says so: CollectionPage carrying an ItemList of
   the guides it points at. The guides themselves publish Article schema; this
   node is what tells a crawler the page above them is the collection. */
const canonical = SITE_URL + '/canton-fair/';
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Canton Fair buyer guide',
  description,
  url: canonical,
  dateModified: '2026-10-14',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    name: 'Canton Fair guides',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: guides.length,
    itemListElement: guides.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.t.split(' — ')[0],
      url: SITE_URL + g.href,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  active="trade-shows"
  crumbs={[{ href: '/trade-shows/', label: 'Trade shows' }]}
  current="Canton Fair"
  cta={{
    eyebrow: 'Next step',
    title: 'Going to the fair? Add the factory days.',
    lead: 'Tell us your categories and which phase you are attending. We will say whether the factory days fit around it — including when the timing does not work.',
    primary: { label: 'Plan a Canton Fair week', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          <p class="eyebrow">Canton Fair</p>
          <h1>Canton Fair Buyer Guide and Factory Visit Planning</h1>
          <p class="lead hero__lead">
            The 140th session runs 15 October to 4 November 2026 in three phases at the Canton Fair
            Complex in Pazhou, Guangzhou. This page is the part nobody at the fair sells you: where
            the fair is today, what it cannot tell you, and the seven guides for before, during and
            after it.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/guides/verify-canton-fair-suppliers/"
              >Get the 7-step verification checklist</a
            >
            <a class="btn btn--secondary" href="#the-guides">See all seven guides</a>
          </div>
        </div>
        <div class="hero__media">
          <PhotoSlot name="CANTON FAIR · THE HALLS" variant="media">
            <OnsitePhoto id="06" eager />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  <Section tight>
    <div class="container">
      <SectionHead
        eyebrow="The 140th session"
        title="Three phases, and where the fair is right now."
        lead="Dates, halls and themes belong to the organiser — confirm the current schedule on cantonfair.org.cn before you book flights."
      />

      {/* Where the session is today. The rail and the line below it are
          dated by app.js; without it the line falls back to the date range,
          which is true on every day of the year. */}
      <div class="fair-status" data-fair-status>
        <div class="fair-status__rail" data-fair-rail>
          {phases.map((p) => (
            <span
              class="fair-status__seg"
              data-fair-seg
              data-phase={p.no}
              data-from={p.from}
              data-to={p.to}
              style={'flex-grow:' + p.days}
            ></span>
          ))}
          <span class="fair-status__fill" data-fair-fill></span>
        </div>
        <p class="fair-status__now" data-fair-now>15 October – 4 November 2026</p>
        <p class="fair-status__note">
          Five exhibition days in each phase. The halls close for switch-over on 20–22 October and
          28–30 October.
        </p>
      </div>

      <ul class="spec-list" style="margin-top: var(--space-6)">
        {phases.map((p) => (
          <li>
            <span class="spec-list__k">{p.dates}</span><span class="spec-list__v">{p.theme}</span>
          </li>
        ))}
      </ul>

      <p class="u-mt-6">
        Each phase covers different categories, so attend the one that holds your product — the
        switch-over days in between are unusable for booths and unusually good for factory visits,
        because the suppliers you met are off duty and the roads are quieter. What three days can
        actually hold is the subject of{' '}
        <a href="/guides/visit-factories-between-canton-fair-phases/">visiting factories between
        Canton Fair phases</a>, including the cases where waiting is the better call. The logistics —
        hotel rates, finding an interpreter, what to carry — are in{' '}
        <a href="/guides/canton-fair-practical-tips-hotels-interpreters/">Canton Fair practical
        tips</a>.
      </p>
    </div>
  </Section>

  <Section id="the-guides" alternate>
    <div class="container">
      <SectionHead
        eyebrow="The seven guides"
        title="Before, during and after."
        lead="Used as a filter, the fair is the most efficient thing in sourcing. Used as the decision itself, it is how buyers end up paying a trading company and believing they paid a factory. These are the guides that sit between those two."
      />
      <div class="related-nav" role="navigation" aria-label="Canton Fair guides">
        {guides.map((g) => (
          <a href={g.href}>
            <span class="related-nav__k">{g.stage}</span>
            <span class="related-nav__t">{g.t}</span>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="What it cannot tell you"
        title="Four questions no booth will answer."
        lead="None of these is answered by a catalogue, a business card or a confident salesperson. Each one has a document or a floor behind it."
      />
      <ul class="spec-list">
        {whatItCannot.map((w) => (
          <li>
            <span class="spec-list__k">{w.k}</span><span class="spec-list__v">{w.v}</span>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        The seven checks that answer them are set out step by step in{' '}
        <a href="/guides/verify-canton-fair-suppliers/">how to verify Canton Fair suppliers</a>, and
        the factory-versus-trader signals are in{' '}
        <a href="/guides/factory-vs-trading-company-china/">factory vs trading company</a>.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead eyebrow="Questions" title="Canton Fair, answered plainly." />
      <FAQ items={faqs} />
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <Caveat
        title="What we are not"
        body="Fair dates, halls, badges and visitor registration belong to the organisers. We plan around them; we do not speak for them, and we do not sell booth space or take a percentage of your order."
        items={[
          'Confirm the current phase dates and hall layout on cantonfair.org.cn before booking anything.',
          'A supplier who cannot produce a full business licence scan at the fair can usually produce one afterwards — if they cannot, treat that as the answer.',
        ]}
      />
    </div>
  </Section>

  <Section alternate>
    <div class="container">
      <SectionHead eyebrow="Go deeper" title="Where to go next." />
      <RelatedNav
        items={[
          { k: 'Trade shows', t: 'Every fair we plan around, and the clusters behind each', href: '/trade-shows/' },
          { k: 'Region', t: 'Guangzhou and Dongguan — the clusters within reach', href: '/destinations/guangzhou-dongguan/' },
          { k: 'Trust', t: 'The five checks in full', href: '/about/how-we-vet-factories/' },
          { k: 'Service', t: 'Factory visit planning', href: '/services/factory-visit-planning/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>
