---
import '../../styles/contact.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import OnsitePhoto from '../../components/OnsitePhoto.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import NoteStrip from '../../components/NoteStrip.astro';
import Caveat from '../../components/Caveat.astro';
import {
  REPLY_TIME,
  REPLY_TIME_PROMISE,
  REPLY_TIME_SHORT,
  FILMING_LEAD_TIME,
  CONTACT_EMAIL,
  HOST_NAME,
  HOST_SIGNATURE,
  isWaConfigured,
  waLink,
} from '../../data/site.ts';

const title = "Contact Our China Factory Visit Team";
const description = "Contact ChinaFactoryHost about supplier visits or factory filming. Send your product, dates, supplier links and the support you need.";

/* Empty until WA_NUMBER is set in site.ts — in which case no wa.me anchor is
   rendered anywhere on this page (critique M3). */
const wa = waLink('Hi, I would like to plan a factory visit in China.');

/* Built here rather than inline: an Astro attribute expression cannot hold a
   `${...}` template substitution — the compiler reads it as a stray token. */
const filmingCaveat = `If your trip is inside the next ${FILMING_LEAD_TIME} and involves filming — we may still help, but permission odds drop sharply.`;
---

<BaseLayout
  title={title}
  description={description}
  track="neutral"
  current="Contact"
  bodyClass="contact-refined"
  cta={false}
>
  <div class="contact-page">
  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          {/* Not just "Contact": this page is a landing target from search and
              shared links, where the visitor has no idea whose site this is. */}
          <p class="eyebrow">Contact ChinaFactoryHost</p>
          <h1>Contact Our China Factory Visit Team</h1>
          <p class="lead hero__lead">
            Send your product, dates and the support you need. If you already have suppliers, include their names or links.
          </p>
        </div>
        <div class="hero__media">
          <PhotoSlot name="TEAM · ZHEJIANG BASE" variant="media">
            <OnsitePhoto id="02" eager />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-options">
    <div class="container">
      <div class="contact-option">
        <span class="eyebrow">01 / Start here</span>
        <h2>Tell us about your visit</h2>
        <p>A product, a destination, or a supplier shortlist — start with what you know.</p>
        <a href="#visit-request">Send a visit request <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact-option">
        <span class="eyebrow">02 / Email us</span>
        <h2>Prefer a written thread?</h2>
        <p>Send your questions and supplier details directly to the same team.</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL} <span aria-hidden="true">↗</span></a>
      </div>
      {isWaConfigured && <div class="contact-option">
        <span class="eyebrow">03 / WhatsApp</span>
        <h2>A quick conversation</h2>
        <p>{REPLY_TIME_PROMISE}, China working hours.</p>
        <a href={wa} target="_blank" rel="noopener">Message us on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>}
    </div>
  </section>

  <Section id="inquiry">
    <div class="container contact-inquiry">
      <aside class="contact-inquiry__intro">
        <p class="eyebrow">Your next step</p>
        <h2>A few details.<br />A useful first conversation.</h2>
        <p>Tell us where you are in the planning process. Dates and supplier links are helpful if you have them.</p>
        <div class="contact-next">
          <h3>What happens next</h3>
          <p>{HOST_NAME} reviews your request and confirms whether we can help.</p>
          <p>{REPLY_TIME_PROMISE}<br />Monday–Friday · China Time (GMT+8)</p>
          <p class="contact-privacy">We do not add inquiries to a mailing list.</p>
        </div>
        <p class="contact-signature">— {HOST_SIGNATURE}</p>
      </aside>
      <div id="visit-request" class="contact-request">
        <InquiryForm title="Send your visit request" lead="Your name, email, visitor type and a short description are required." />
      </div>
    </div>
  </Section>

  <!-- Response time + timezone -->
  <Section alternate id="tz-table">
    <div class="container container--md">
      <SectionHead
        eyebrow="Working hours"
        title="China Time (GMT+8) against your clock."
        lead="Use China Time when arranging appointments. Check daylight-saving differences for your location."
      />
      <p class="contact-table-hint" id="contact-table-hint" hidden>Scroll across for local times →</p>
      <div class="contact-table-scroll" role="region" aria-label="Time zone comparison" aria-describedby="contact-table-hint">
      <table class="tz-table">
        <caption class="sr-only">China Time GMT+8 against common client timezones</caption>
        <thead>
          <tr>
            <th scope="col">Your location</th>
            <th scope="col">Time zone</th>
            <th scope="col">Our 09:00–18:00 is your…</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">US West Coast</th><td>PST / PDT</td><td>17:00–02:00 (previous day)</td></tr>
          <tr><th scope="row">US East Coast</th><td>EST / EDT</td><td>20:00–06:00 (previous day)</td></tr>
          <tr><th scope="row">United Kingdom</th><td>GMT / BST</td><td>01:00–10:00</td></tr>
          <tr><th scope="row">Central Europe</th><td>CET / CEST</td><td>02:00–11:00</td></tr>
          <tr><th scope="row">Australia East</th><td>AEST / AEDT</td><td>11:00–20:00</td></tr>
          <tr><th scope="row">Southeast Asia</th><td>ICT / WIB</td><td>08:00–17:00</td></tr>
        </tbody>
      </table>
      </div>
      <p class="cost-footnote">
        Our working day is Monday to Friday, 09:00–18:00 China Time. Overlap with North America is
        small — that is why WhatsApp tends to work better than scheduled calls for anything urgent.
      </p>
    </div>
  </Section>

  <!-- HQ -->
  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="Where we are" title="Zhejiang headquarters, nationwide reach." />
      <ul class="spec-list clean">
        <li>
          <span class="spec-list__k">Home base</span><span class="spec-list__v"
            >Zhejiang — Hangzhou · Yiwu · Ningbo</span
          >
        </li>
        <li>
          <span class="spec-list__k">Resident team</span><span class="spec-list__v"
            >Pearl River Delta — Shenzhen · Dongguan · Guangzhou</span
          >
        </li>
        <li>
          <span class="spec-list__k">Reachable with notice</span><span class="spec-list__v"
            >Shandong · Hebei · Jiangsu · Fujian · Sichuan</span
          >
        </li>
        <li>
          <span class="spec-list__k">Working languages</span><span class="spec-list__v"
            >English · Mandarin · local dialects at site level</span
          >
        </li>
        <li>
          <span class="spec-list__k">Response window</span><span class="spec-list__v"
            >{REPLY_TIME_SHORT}, Monday–Friday GMT+8</span
          >
        </li>
      </ul>
      <div class="u-mt-6">
        <NoteStrip label="Registered details" marker="case"
          >Street address, registered company name and business licence number are still to be
          published. Ask us for them — we will send them before you pay anything.</NoteStrip
        >
      </div>
    </div>
  </Section>

  <!-- Straight-talking closer -->
  <Section alternate>
    <div class="container container--md">
      <Caveat
        title="Is our support right for you?"
        body="A few boundaries to help you plan the right next step."
        items={[
          'If you only want the cheapest possible unit price and are not visiting China — a remote sourcing agent will serve you better.',
          'If you need a licensed product certification or a full social-compliance audit — we are neither an auditor nor a certification body.',
          filmingCaveat,
          'If you want us to sign contracts or move money on your behalf — we will not.',
        ]}
      />
    </div>
  </Section>
  </div>
</BaseLayout>

<script>
  const tableRegion = document.querySelector<HTMLElement>('.contact-table-scroll');
  const tableHint = document.querySelector<HTMLElement>('#contact-table-hint');
  if (tableRegion && tableHint) {
    const updateTable = () => {
      const overflowing = tableRegion.scrollWidth > tableRegion.clientWidth + 1;
      tableHint.hidden = !overflowing;
      tableRegion.tabIndex = overflowing ? 0 : -1;
    };
    new ResizeObserver(updateTable).observe(tableRegion);
    updateTable();
  }
</script>
