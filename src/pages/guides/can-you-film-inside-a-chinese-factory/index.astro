---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import OnsitePhoto from '../../../components/OnsitePhoto.astro';
import Checklist from '../../../components/Checklist.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import RelatedNav from '../../../components/RelatedNav.astro';
import { waLink, FILMING_LEAD_TIME, FILMING_LEAD_TIME_SHORT } from '../../../data/site.ts';

const title = 'Can you film inside a Chinese factory? — the honest answer';
const description =
  'Often yes, but it depends on the factory, the category and the city. What gets approved, what gets refused, the lead time, and who owns the footage.';

const wa = waLink('Hi, I want to know if I can film inside a Chinese factory.');

const permission = [
  { k: 'Who can say yes', v: 'The owner or general manager, not the sales rep. A request that stops at sales almost never reaches the person who can approve it.' },
  { k: 'How far ahead', v: 'Permission needs to be requested ' + FILMING_LEAD_TIME + ' ahead, in writing. Under ' + FILMING_LEAD_TIME_SHORT + ' the honest expectation is often a refusal — not hostility, just a request that has not had time to route.' },
  { k: 'The right to refuse', v: 'A factory can decline for any reason, and some lines are off-limits by contract. Our job is not to overcome a no — it is to know which factories will say yes and have a substitute ready.' },
];

const approved = [
  'Assembly and packing lines — the most commonly approved areas',
  'The warehouse and loading area',
  'Worker and owner interviews, with consent',
  'The production floor during a scheduled window',
];

const refused = [
  'Lines running a foreign-brand order under NDA',
  'Clean rooms and certain finishing processes',
  'Screens showing customer names or unshipped designs',
  'The tooling or mould store in many plants — treated as IP',
  'Drone use near industrial zones, unless cleared in writing',
];

const processSteps = [
  { n: '01', title: 'Written request to the owner', body: 'The request names the factory, the zones and the purpose. Addressed to the owner, not the sales contact — that is the difference between a real answer and a stalled one.' },
  { n: '02', title: 'Restrictions agreed per zone', body: 'Which areas are open, which are closed and which need a review, agreed in writing before you book anything.' },
  { n: '03', title: 'Substitute held', body: 'A refusal is planned for, not reacted to. Every itinerary keeps a second factory, so a no costs you a location, not a shooting day.' },
  { n: '04', title: 'Confirm before you fly', body: 'You board knowing what is filmable. Nothing is promised over the phone that is not confirmed in writing.' },
];

const finePrint = [
  { k: 'How early to ask', v: 'In writing, ' + FILMING_LEAD_TIME + ' ahead. Under ' + FILMING_LEAD_TIME_SHORT + ' and the honest expectation is often a refusal.' },
  { k: 'Who owns the footage', v: 'You do. Some factories ask to review what you publish — that condition is agreed in writing up front, not negotiated afterwards.' },
  { k: 'The NDA scope', v: 'An NDA usually covers the factory’s customers and prices, not your footage. Read the scope before you sign.' },
  { k: 'Substitutes', v: 'Every itinerary holds a substitute factory, so a refusal costs you a location, not a shooting day.' },
];

const logistics = [
  { k: 'Power', v: 'Factory floors are 220V and usually fine, but a long shoot should bring its own batteries — the nearest socket may be across a moving line.' },
  { k: 'Network', v: 'Signal inside a concrete plant is often poor. Plan to record offline; do not design a shoot around live streaming from the floor.' },
  { k: 'Equipment entry', v: 'Declare cameras, lights and stabilisers ahead so security knows what is coming. Undeclared gear at the gate is the fastest way to lose a morning.' },
  { k: 'Environment', v: 'Dust, heat and noise are part of the floor. Plan for them — it is what makes factory footage look real instead of staged.' },
];
---

<BaseLayout
  title={title}
  description={description}
  active=""
  crumbs={[]}
  current="Can you film inside a factory?"
  cta={{
    eyebrow: 'Next step',
    title: 'Check whether your specific shoot is feasible.',
    lead: 'Send the category, the city and the dates. You get a straight answer before you book a flight.',
    primary: { label: 'Check my shoot', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          <p class="eyebrow">Guide</p>
          <h1>Can you film inside a Chinese factory? Often, but not always.</h1>
          <p class="lead hero__lead">
            The honest answer depends on the factory, the category and the city. Some welcome cameras,
            some allow it only with approval, and a few decline — we confirm which one you are facing
            before you book a flight.
          </p>
        </div>
        <div class="hero__media">
          <PhotoSlot name="GUIDE · FILMING" variant="media">
            <OnsitePhoto id="07" />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="Permission" title="The real boundary of filming permission." />
      <ul class="spec-list clean">
        {permission.map((p) => (
          <li>
            <span class="spec-list__k">{p.k}</span><span class="spec-list__v">{p.v}</span>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        This is the process we run on <a href="/services/on-site-support/filming-coordination/">filming coordination</a> —
        the written request, the zone-by-zone restrictions, and the substitute factory held in reserve.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead eyebrow="What is possible" title="What typically gets approved, and what does not." />
      <Checklist title="Usually filmable" items={approved} />
      <div class="u-mt-6">
        <Checklist title="Usually refused" items={refused} refusal plain />
      </div>
      <p class="u-mt-6">
        Which side of the line your shoot falls on is a cluster-by-cluster question — <a href="/destinations/yiwu/">Yiwu</a> is
        among the most filming-friendly, while large Ningbo plants route requests more slowly.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="The process" title="How permission actually gets arranged." />
      <ProcessSteps items={processSteps} />
      <p class="u-mt-6">
        The result is what <a href="/who-we-help/creators/">creators</a> actually get: a route built around the shot
        list, and a straight answer on what will not film before anyone books a flight.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead eyebrow="The fine print" title="Lead time, ownership and the NDA." />
      <ul class="spec-list clean">
        {finePrint.map((f) => (
          <li>
            <span class="spec-list__k">{f.k}</span><span class="spec-list__v">{f.v}</span>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        All of this is settled in writing before you fly — which is exactly what <a href="/services/on-site-support/filming-coordination/">filming coordination</a> is for.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead eyebrow="On the floor" title="Power, network and equipment limits." />
      <ul class="spec-list clean">
        {logistics.map((l) => (
          <li>
            <span class="spec-list__k">{l.k}</span><span class="spec-list__v">{l.v}</span>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        If you want the permission and the logistics handled end to end, that is the <a href="/services/creator-factory-tour/">creator factory tour</a>.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container">
      <SectionHead eyebrow="Go deeper" title="Related pages." />
      <RelatedNav
        items={[
          { k: 'Service', t: 'Filming coordination', href: '/services/on-site-support/filming-coordination/' },
          { k: 'Service', t: 'Creator factory tour', href: '/services/creator-factory-tour/' },
          { k: 'Audience', t: 'Creators', href: '/who-we-help/creators/' },
          { k: 'Region', t: 'Yiwu', href: '/destinations/yiwu/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>
