---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/growth-editorial.css';
const guides=[["Plan","Plan a China factory visit","/guides/how-to-plan-a-china-factory-visit/"],["Budget","Factory visit costs and quote inclusions","/guides/china-factory-visit-cost/"],["Prepare","Questions to ask Chinese suppliers","/guides/questions-to-ask-china-factory-visit/"],["Check","Factory visit checklist","/guides/china-factory-visit-checklist/"],["Choose","Factory or trading company?","/guides/factory-vs-trading-company-china/"],["Choose","Visit, audit or product inspection?","/guides/factory-visit-vs-audit-vs-inspection/"],["Film","Filming permission in Chinese factories","/guides/can-you-film-inside-a-chinese-factory/"],["Canton Fair","Verify a supplier after the fair","/guides/verify-canton-fair-suppliers/"],["Canton Fair","Turn a fair shortlist into factory visits","/guides/canton-fair-to-factory-visits/"],["Canton Fair","Visit factories between fair phases","/guides/visit-factories-between-canton-fair-phases/"],["Canton Fair","Is the fair worth it for small buyers?","/guides/is-canton-fair-worth-it-for-small-buyers/"],["Canton Fair","Hotels, interpreters and practical preparation","/guides/canton-fair-practical-tips-hotels-interpreters/"],["Canton Fair","Continue to Zhejiang","/destinations/zhejiang/canton-fair-to-zhejiang-factory-visits/"],["Canton Fair","Discuss MOQ as a small buyer","/guides/canton-fair-moq-for-small-buyers/"]];
guides.unshift(["Directory", "China trade fairs by product, city and date", "/china-trade-fairs/"]);

guides.unshift(["Reference", "Factory visit glossary — 20 terms in English, Chinese and pinyin", "/guides/china-factory-visit-glossary/"]);
---
<BaseLayout title="China Factory Visit and Sourcing Guides" description="Prepare a China sourcing trip: budgets, supplier questions, on-site checks and practical Canton Fair guides." current="Guides" cta={false}>
<div class="growth-article"><header><h1>China factory visit and sourcing guides</h1><p class="lead">Prepare the visit, ask better questions and keep the evidence you need to compare suppliers.</p></header>
<section><h2>Choose the question you need to answer</h2><nav class="related-nav" aria-label="Guides">{guides.map(g=><a href={g[2]}><span class="related-nav__k">{g[0]}</span><span class="related-nav__t">{g[1]}</span></a>)}</nav></section>
<section class="note"><h2>Use the tools alongside the guides</h2><p>Find research starting points with the <a href="/tools/china-manufacturing-hub-finder/">manufacturing hub finder</a>. Record observations and open questions in the <a href="/tools/factory-visit-scorecard/">supplier comparison template</a>.</p><p><a href="/factory-visits/">See what local visit support can cover</a></p></section>
</div></BaseLayout>
