---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import OnsitePhoto from '../../../components/OnsitePhoto.astro';
import Checklist from '../../../components/Checklist.astro';
import Timeline from '../../../components/Timeline.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CalendarStrip from '../../../components/CalendarStrip.astro';
import ReadinessList from '../../../components/ReadinessList.astro';
import FAQ from '../../../components/FAQ.astro';
import Caveat from '../../../components/Caveat.astro';
import RelatedNav from '../../../components/RelatedNav.astro';
import DownloadGate from '../../../components/DownloadGate.astro';
import { waLink } from '../../../data/site.ts';

const title = "Factory Visits Between Canton Fair Phases: Time and Planning";
const description =
  'The 140th Canton Fair has two three-day gaps with no exhibition, 20–22 and 28–30 October 2026. What you can fit into them, what to confirm first, and when to wait until after the fair.';

const wa = waLink('Hi, I am at Canton Fair and want to use the days between phases for factory visits.');

/* ── The organiser's schedule, as structured date records ───────────────────
   Same facts as the /canton-fair/ hub publishes — the two pages must never
   disagree, so any date change happens in both files in one commit. Phase
   themes stay verbatim below in `phaseThemes`. */
const schedule = [
  { id: 'p1', kind: 'phase', name: 'Phase 1', dates: '15–19 Oct', iso: '2026-10-15/2026-10-19', days: 5, note: 'Exhibition open' },
  { id: 'g1', kind: 'gap', name: 'Gap 1', dates: '20–22 Oct', iso: '2026-10-20/2026-10-22', days: 3, note: 'Switch-over — halls closed' },
  { id: 'p2', kind: 'phase', name: 'Phase 2', dates: '23–27 Oct', iso: '2026-10-23/2026-10-27', days: 5, note: 'Exhibition open' },
  { id: 'g2', kind: 'gap', name: 'Gap 2', dates: '28–30 Oct', iso: '2026-10-28/2026-10-30', days: 3, note: 'Switch-over — halls closed' },
  { id: 'p3', kind: 'phase', name: 'Phase 3', dates: '31 Oct–4 Nov', iso: '2026-10-31/2026-11-04', days: 5, note: 'Exhibition open' },
];

const scheduleFootnotes = [
  'Both windows are three days, with the halls closed for switch-over — the suppliers you met are off booth duty. Gap 2 is the quieter, last one: after Phase 3 the fair simply ends.',
  'After 4 November there is no deadline pulling you back to Pazhou. A multi-province trip becomes possible then — not inside the gaps.',
];

const phaseThemes = [
  { k: 'Phase 1 · 15–19 October', v: 'Advanced manufacturing — appliances and consumer electronics, machinery, vehicles and parts, lighting, hardware and tools.' },
  { k: 'Phase 2 · 23–27 October', v: 'Quality home life — ceramics, kitchenware, household goods, gifts and festival items, building materials, furniture.' },
  { k: 'Phase 3 · 31 October – 4 November', v: 'Better living — toys, apparel, textiles and fabrics, shoes and bags, home textiles, stationery, food, sports and leisure.' },
];

/* Four conditions, regrouped from the old `decide` rows: the question, the
   action that answers it, and the fact behind it. No sentence was invented —
   the originals were only split at their natural joints. */
const readiness = [
  {
    q: 'Is the supplier still available?',
    action: 'Ask directly: "Will your team be at the factory on 21 October?" Do not assume.',
    note: 'Exhibitors differ by phase. A supplier you met in Phase 1 may have gone home, or may still be at the venue for a few days.',
  },
  {
    q: 'Has the factory confirmed in writing?',
    action: 'Exact address, date and start time, the host’s name, and which areas you may see — in writing.',
    note: 'Without a written confirmation a day can disappear.',
  },
  {
    q: 'Where is the factory?',
    action: 'Check the city on the licence and the quotation, then check real travel times including the station and the last kilometre.',
    note: 'Not necessarily in Guangzhou. A factory that looks close on a map can cost half a day in transfers.',
  },
  {
    q: 'What do you need from the visit?',
    action: 'State one purpose per factory — verify production, discuss a custom product, inspect a sample, or negotiate.',
    note: 'A visit with a stated purpose is shorter and returns more.',
  },
];

/* The three ways to use a gap, regrouped from `threeWays` into comparison
   rows. Stay local and one-cluster are not mutually exclusive — see the
   note under the table. */
const compare = {
  columns: [
    { name: 'Stay local', sub: 'In or near Guangzhou — the outer districts, Foshan and Dongguan are all within reach.' },
    { name: 'One cluster, several factories', sub: 'Go to one production region and visit two or three suppliers there.' },
    { name: 'Verify remotely', sub: 'Use video calls instead of travelling.' },
  ],
  rows: [
    {
      label: 'Best for',
      values: [
        'Suppliers already in the same area, and limited time.',
        'One product category sourced from one area.',
        'Buyers who cannot spare the days, or whose factories are a long way from Guangzhou.',
      ],
    },
    {
      label: 'Watch out for',
      values: [
        'Assuming a supplier is local when the licence says another city.',
        'A cluster trip only works with confirmed appointments and a hard daily limit.',
        'A video is weaker evidence than a visit — use it to narrow the list, not to close it.',
      ],
    },
  ],
};

/* Three-day example plan — same three days the old prose blocks described,
   now as the itinerary structure they always were. */
const threeDay = [
  {
    day: 'DAY 1',
    time: 'SORT & VERIFY',
    title: 'Cards, records, written requests',
    desc: 'Sort the cards into continue, ask more and drop. Check the company records of the shortlist, then send written visit requests asking for confirmation of the address, the time and the host.',
  },
  {
    day: 'DAY 2',
    time: 'ONE CLUSTER',
    title: 'Two or three factories in one area',
    desc: 'Start early. Bring your specification and the supplier’s sample or quotation, use the same checklist at every factory, and write up the notes the same evening. Two visits in a day is the useful number — the second conversation is sharper because the first one told you what to ask.',
  },
  {
    day: 'DAY 3',
    time: 'FOLLOW UP',
    title: 'Written summaries, or hand back',
    desc: 'Send each supplier a written summary of what was agreed and what is still open, request samples, then either return to Guangzhou for the next phase or carry on to your next destination.',
  },
];

const notWorth = [
  'The supplier has not confirmed a date, an address and a host in writing.',
  'The factory is far enough that the round trip would eat most of the gap.',
  'You have not yet checked the company records.',
  'You are not clear what you want to check once you are there.',
  'You are tired and the next phase starts in three days. A rushed visit returns less than a rested one.',
];

const prep = [
  'Your specification, drawings or reference samples.',
  'The supplier’s quotation and what they told you at the booth.',
  'A written list of questions.',
  'Your target quantity, delivery date and destination market.',
  'A way to record notes and photos — with permission.',
  'An interpreter, if your Chinese is limited.',
];

const faqs = [
  {
    q: 'Can I visit factories while Canton Fair is still running?',
    a: [
      'Yes, but the days the halls are open are usually full of booth meetings. The switch-over gaps are easier to use, provided the supplier confirms they are available.',
    ],
  },
  {
    q: 'How many factories can I visit in one day?',
    a: [
      'Two or three at most, and fewer if they are in different cities. Rushed visits return less information than fewer visits done properly.',
    ],
  },
  {
    q: 'Should I visit before I order samples?',
    a: [
      'It depends. Visiting first suits high-value or custom products; samples first suit lower-cost products where a trip may never pay for itself. The trade-off is set out step by step in the Canton Fair to factory visits guide.',
    ],
  },
  {
    q: 'Is a video call a good substitute?',
    a: [
      'It is useful for narrowing a list and weaker than a visit. A video shows what the supplier chooses to show; a visit lets you see the workshop, the material store and the work in progress for yourself.',
    ],
  },
  {
    q: 'What if I only have three days in China?',
    a: [
      'Prioritise verification, sorting your notes and one or two confirmed visits. Do not try to cover more than one region in three days.',
    ],
  },
  {
    q: 'Can someone visit the factory for me?',
    a: [
      'Yes. A local representative can visit, photograph and film, and report back using your checklist. Agree in advance on what they should record, and ask for the raw files, not only a summary.',
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  active=""
  crumbs={[{ href: '/canton-fair/', label: 'Canton Fair' }]}
  current="Visiting factories between phases"
  article={{
    title,
    description,
    datePublished: '2026-10-14',
    dateModified: '2026-10-14',
    section: 'Factory Visits',
  }}
  cta={{
    eyebrow: 'Next step',
    title: 'Send us the list and the dates.',
    lead: 'Tell us which suppliers you want to see, which cities they are in and which gap you have. We will say what is realistic, which visits can be grouped, and what to confirm before you commit the days.',
    primary: { label: 'Plan the gap days', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <section class="hero">
    <div class="container">
      <div class="split-7-5">
        <div>
          <p class="eyebrow">Guide</p>
          <h1>Factory Visits Between Canton Fair Phases: Time and Planning</h1>
          <p class="lead hero__lead">
            The 140th session has two three-day gaps with no exhibition at all, 20–22 and 28–30
            October 2026. That is enough for factories inside one region, provided the suppliers
            confirm in writing and you group the visits. It is not enough for a multi-province tour.
          </p>
          <div class="btn-row">
            <a class="btn btn--secondary" href="#checklist-download">Get the visit checklist</a>
          </div>
        </div>
        <div class="hero__media">
          <PhotoSlot name="GUIDE · THE SWITCH-OVER DAYS" variant="media">
            <OnsitePhoto id="07" />
          </PhotoSlot>
        </div>
      </div>
    </div>
  </section>

  {/* ── The schedule, as a schedule ─────────────────────────────────────────
      The old version showed three phase rows and three gap rows as two
      spec-lists — six key/value rows in the same visual grammar as every
      other list on the page. A schedule is a sequence with durations, so it
      is now one proportional strip: five segments, phases neutral, the two
      switch-over windows carrying the brand colour because they are the
      entire subject of the page. */}
  <Section tight>
    <div class="container">
      <SectionHead
        eyebrow="The 140th session · 2026"
        title="Three phases, and the two gaps between them."
      />
      <CalendarStrip
        year="2026"
        meta="Organiser's schedule — confirm current dates on cantonfair.org.cn"
        segments={schedule}
        footnotes={scheduleFootnotes}
      />
      <p class="u-mt-6">
        Because each phase covers different categories, the gaps mostly help buyers who attend more
        than one phase, or who finish a phase and want to act on what they found before the next one
        starts.
      </p>
      <details class="phase-detail">
        <summary>What each phase covers</summary>
        <dl class="phase-detail__list">
          {phaseThemes.map((p) => (
            <div>
              <dt>{p.k}</dt>
              <dd>{p.v}</dd>
            </div>
          ))}
        </dl>
      </details>
    </div>
  </Section>

  {/* ── Four conditions, as a check ────────────────────────────────────────
      Was: a lead paragraph, four long key/value rows, and a closing paragraph
      that repeated the lead. Now: question → action → fact, scannable in a
      2×2 grid, with one closing reminder. The full "what to ask for in
      writing" detail stays where it always lived — step three of the
      from-booth-to-visit guide. */}
  <Section alternate>
    <div class="container container--md">
      <SectionHead title="Four things decide whether the gap works." />
      <ReadinessList items={readiness} />
      <p class="u-mt-6">
        Without a written date and a real address, confirm first and route second — the full list of
        what to ask for in writing is step three of{' '}
        <a href="/guides/canton-fair-to-factory-visits/">from Canton Fair to factory visits</a>.
      </p>
    </div>
  </Section>

  {/* ── Three options, as a comparison ─────────────────────────────────────
      Was: three more key/value rows. "Best for" and "Watch out for" are the
      same two questions asked of each option — that is a table, and the
      table's own mobile rendering keeps the field order aligned. */}
  <Section>
    <div class="container">
      <SectionHead title="How buyers actually use the gap." />
      <ComparisonTable
        caption="Three ways to use the switch-over gap: stay local, one cluster with several factories, or verify remotely."
        labelCol="Compare"
        columns={compare.columns}
        rows={compare.rows}
      />
      <p class="u-mt-6">
        Stay local and one-cluster are not either/or — a local visit on one day and a cluster trip on
        the next is a normal shape. For most buyers the best use of a gap is not a long trip anyway:
        it is rest, sorting the notes while they still mean something, running the company checks,
        and one or two factory visits that were confirmed before the halls closed. The five checks
        behind that are in <a href="/about/how-we-vet-factories/">how we vet factories</a>.
      </p>
    </div>
  </Section>

  {/* ── The example plan, as an itinerary ──────────────────────────────────
      Was: three H3 + paragraph blocks in prose styling — a day-by-day plan
      wearing article clothes. Timeline renders days; it stays an example,
      stated in the heading, and no day gets a stock factory photo it does
      not belong to. */}
  <Section alternate>
    <div class="container">
      <SectionHead title="A three-day plan, as an example." />
      <div class="gap-plan">
        <Timeline items={threeDay} />
      </div>
      <p class="u-mt-6">
        Day 1’s records-and-requests routine is the seven-step walkthrough in{' '}
        <a href="/guides/verify-canton-fair-suppliers/">how to verify Canton Fair suppliers</a>. If
        your suppliers sit in Zhejiang or elsewhere in the Yangtze River Delta, a proper trip
        usually takes longer than three days — which town to go to is decided by the product, and
        that town-by-town map is in{' '}
        <a href="/destinations/zhejiang/canton-fair-to-zhejiang-factory-visits/">Canton Fair to
        Zhejiang</a>. The clusters around the fair itself are mapped in{' '}
        <a href="/destinations/guangzhou-dongguan/">Guangzhou and Dongguan</a>, and the sequencing
        is what <a href="/services/factory-visit-planning/">visit planning</a> handles.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Free download"
        title="Take the visit checklist with you."
        lead="The checks in this guide, in the order we run them on site."
      />
      <DownloadGate
        id="checklist-download"
        lead="You have a few days and one factory visit inside them. These are the five checks we run on that day, and the evidence we ask for."
      />
    </div>
  </Section>

  {/* ── Two compact lists, deliberately not twins ───────────────────────────
      "When to wait" is a decision (refusal styling), "what to bring" is a
      packing list (plain). Different jobs, different look, one section: the
      old version gave each its own H2 + lead + full-width band. */}
  <Section alternate>
    <div class="container container--md">
      <div class="twocol">
        <div>
          <SectionHead title="When to wait instead." />
          <Checklist title="Wait instead when" refusal items={notWorth} />
        </div>
        <div>
          <SectionHead title="What to bring." />
          <Checklist title="Six things" plain items={prep} />
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead title="Frequently asked questions." />
      <FAQ items={faqs} />
      <p class="u-mt-6">
        Two of those answers have a longer version elsewhere: the visit-versus-samples trade-off is
        argued out in <a href="/guides/canton-fair-to-factory-visits/">from Canton Fair to factory
        visits</a>, and sending someone in your place is one of the{' '}
        <a href="/services/existing-supplier-visits/">existing supplier visits</a> we run.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <Caveat
        title="What this guide can and cannot promise"
        body="Fair dates, halls, badges and the switch-over schedule belong to the organisers; we plan around them and do not speak for them. Whether a specific supplier will host you on a specific day is the supplier's decision, not ours. This page is general information, not legal advice."
        items={[
          'Confirm the current phase dates on cantonfair.org.cn before booking flights or a hotel.',
          'A three-day gap is enough for one region. It is not enough for Guangzhou plus Zhejiang plus Jiangsu.',
        ]}
      />
      <p class="u-mt-6">
        Everything about the fair itself — phases, what it can and cannot tell you, and where the
        factories actually sit — is on the <a href="/canton-fair/">Canton Fair buyer guide</a>.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container">
      <SectionHead title="Related pages." />
      <RelatedNav
        items={[
          { k: 'Canton Fair', t: 'The fair itself — phases, switch-over days, factory days', href: '/canton-fair/' },
          { k: 'Guide', t: 'From Canton Fair to factory visits — the 8-step route', href: '/guides/canton-fair-to-factory-visits/' },
          { k: 'Guide', t: 'Verify Canton Fair suppliers — 7 steps', href: '/guides/verify-canton-fair-suppliers/' },
          { k: 'Region', t: 'Guangzhou and Dongguan — the clusters within reach', href: '/destinations/guangzhou-dongguan/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>

<style>
  /* Phase themes: supplementary to the strip, collapsed by default — the
     key dates and both windows stay visible without opening anything. */
  .phase-detail {
    margin-top: var(--space-6);
    border-top: 1px solid var(--ink-100);
    padding-top: var(--space-4);
  }
  .phase-detail summary {
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .phase-detail summary:hover { color: var(--text-primary); }
  .phase-detail[open] summary { margin-bottom: var(--space-4); }
  .phase-detail__list {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .phase-detail__list dt {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .phase-detail__list dd {
    margin: 2px 0 0;
    font-size: var(--fs-body-sm);
    color: var(--text-secondary);
  }
  @media (min-width: 768px) {
    .phase-detail__list div { display: grid; grid-template-columns: 220px 1fr; gap: var(--space-4); align-items: baseline; }
  }

  /* Timeline ships with a five-column desktop grid (its other call sites pass
     five or six items). This plan has three days — three columns, via a page
     scoped override so no other page's timeline changes. */
  @media (min-width: 1024px) {
    .gap-plan :global(.timeline) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* The two compact lists share one band at desktop, stack on phones. */
  .twocol { display: grid; gap: var(--space-8); }
  @media (min-width: 1024px) {
    .twocol { grid-template-columns: 1fr 1fr; gap: var(--space-10); }
  }
</style>
