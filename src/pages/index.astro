---
/* ChinaFactoryHost — homepage.

   Rebuilt from scratch on BaseLayout + the V3 component set. The previous file
   was a second, contradictory design system: its own <html>/<head>, its own hex
   palette, six gradient icon tints, 999px pill buttons, gradient text and a
   gradient CTA block. It was patched onto nothing and shared nothing. V3 could
   not ship while the homepage spoke a different language, so this page is
   content-migration only — every string below is the same claim the old page
   made, moved into the right container.

   Section rhythm follows §5.4 and alternates surfaces (white → tint → white …).
   Dark bands: the hero (a photograph) and the closing CTA — exactly two, and
   never adjacent (§3.4).

   No numbers appear anywhere on this page. We cannot source a single figure yet,
   and inventing statistics about factory access would destroy the only asset
   this site actually has: being the one source that does not overclaim. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Checklist from '../components/Checklist.astro';
import FAQ from '../components/FAQ.astro';
import TrustBar from '../components/TrustBar.astro';
import CostComparison from '../components/CostComparison.astro';
import Icon from '../components/Icon.astro';
/* Every figure on this page is DERIVED from a constant that also renders
   elsewhere on the site — never hand-typed. See the TrustBar below. */
import { REPLY_TIME_MICRO, FILMING_LEAD_TIME, FILMING_LEAD_TIME_DAYS, VET_STEPS } from '../data/site.ts';

const creatorPoints = [
  'Film inside real factories, not trade-company showrooms',
  'Bilingual fixer handles permits, access and interviews',
  'A shared route or a private crew, your call',
];

const buyerPoints = [
  'Verify the factory before you fly 20 hours',
  'Meet the production manager, not a sales rep',
  'Structured visit plan, plain-English reporting',
];

/* Hero claims. Qualitative on purpose — see the file header. */
const heroClaims = [
  'Factory verification, step by step',
  'English-speaking escorts on site',
  'No hidden commissions',
];

const services = [
  {
    title: 'Creator factory tours',
    desc: 'Join a group departure or book a private crew route. Filming is coordinated end to end.',
    icon: 'camera',
    href: '/services/creator-factory-tour/',
    cta: 'See the creator route',
  },
  {
    title: 'Brand sourcing visits',
    desc: 'Custom itineraries for Amazon sellers, DTC founders and procurement teams.',
    icon: 'clipboard',
    href: '/services/brand-sourcing-visit/',
    cta: 'See the buyer route',
  },
  {
    title: 'Factory verification',
    desc: 'Business licence, registered scope, capacity and the production floor itself, checked before you commit.',
    icon: 'shield',
    href: '/about/how-we-vet-factories/',
    cta: 'Read the method',
  },
  {
    title: 'Filming coordination',
    desc: 'Permits, access, interviews and safe handling of your gear on the floor.',
    icon: 'film',
    href: '/services/on-site-support/filming-coordination/',
    cta: 'How filming works',
  },
  {
    title: 'Translation and escort',
    desc: 'Bilingual escorts who know the technical vocabulary, not just the small talk.',
    icon: 'translate',
    href: '/services/on-site-support/',
    cta: 'What is on site',
  },
  {
    title: 'Transport and logistics',
    desc: 'City-to-city and factory-to-factory routing that respects shift times.',
    icon: 'car',
    href: '/services/on-site-support/',
    cta: 'How routing works',
  },
];

const steps = [
  {
    n: '01',
    title: 'Tell us your goal',
    body: 'What are you sourcing or filming, and in which category?',
  },
  {
    n: '02',
    title: 'We shortlist factories',
    body: 'Vetted matches in the right industrial cluster, never trade companies.',
  },
  {
    n: '03',
    title: 'We plan the route',
    body: 'Cluster-by-cluster itinerary, transport and interpreter locked in.',
  },
  {
    n: '04',
    title: 'You walk the floor',
    body: 'Meet the production manager. We handle everything around you.',
  },
];

/* §1.1 #6 / requirements §10: four reasons, and each one links to the page that
   carries its evidence. A claim with no landing page does not belong here. */
const whyUs = [
  {
    icon: 'shield',
    title: 'Vetted before you book',
    desc: 'Every shortlist starts from a checked business licence, a registered scope and a production floor we have walked.',
    href: '/about/how-we-vet-factories/',
    cta: 'See the vetting steps',
  },
  {
    icon: 'film',
    title: 'Filming access confirmed first',
    desc: 'We find out what is actually shootable, factory by factory and category by category, before you book a flight.',
    href: '/services/on-site-support/filming-coordination/',
    cta: 'Filming coordination',
  },
  {
    icon: 'route',
    title: 'Routing that respects shift times',
    desc: 'Itineraries are built around production schedules and industrial clusters, not around tourist itineraries.',
    href: '/services/on-site-support/',
    cta: 'On-site support',
  },
  {
    icon: 'target',
    title: 'One team, shortlist to floor',
    desc: 'The people who vet the factory are the people standing next to you on the visit. Nothing is subcontracted.',
    href: '/services/brand-sourcing-visit/',
    cta: 'Brand sourcing visits',
  },
];

const destinations = [
  { k: 'Small commodities and gifts', t: 'Yiwu', href: '/destinations/yiwu/' },
  { k: 'Appliances, hardware, textiles', t: 'Ningbo / Hangzhou', href: '/destinations/ningbo-hangzhou/' },
  { k: 'Electronics and drones', t: 'Shenzhen', href: '/destinations/shenzhen/' },
  { k: 'OEM and private label', t: 'Guangzhou / Dongguan', href: '/destinations/guangzhou-dongguan/' },
];

/* CostComparison rows. Deliberately NUMBER-FREE: nothing here asserts a price,
   a saving or a duration we could not produce a receipt for. Each row states
   who performs the work; rows marked `hidden` are the costs that never appear
   on a quote but are always paid — in translation gaps, in unbudgeted days, or
   folded into a unit price you cannot see (§5.7). */
const costRows = [
  {
    item: 'Finding factories that actually make your product',
    diy: 'Marketplaces and search results, with no way to check which listing is a factory and which is a trading company',
    us: 'Shortlisted from the clusters we work in, licence and registered scope checked first',
  },
  {
    item: 'Filming permission',
    diy: 'Asked on arrival, factory by factory, in Mandarin',
    us: `Requested in writing ${FILMING_LEAD_TIME} before you fly`,
    hidden: true,
  },
  {
    item: 'Interpreter on the floor',
    diy: 'Whoever the supplier sends, or a general guide without the technical vocabulary',
    us: 'A bilingual escort who works in your category',
    hidden: true,
  },
  {
    item: 'Routing between factories and cities',
    diy: 'Built around hotels and whatever the city makes easy',
    us: 'Sequenced by industrial cluster and shift times',
  },
  {
    item: 'What the factory pays us',
    diy: 'Often a commission folded into your unit price — invisible by design',
    us: 'Nothing. Two visible lines, disclosed in writing before you pay',
    hidden: true,
  },
  {
    item: 'Trip cost',
    diy: '—',
    us: '—',
    total: true,
  },
];

/* Stated as commitments, not as claims about anyone else. Rendered with the
   refusal marker: a check mark beside a refusal reads as "confirmed: we do not
   do this", which is the exact opposite of the meaning (§3.4, redundant
   encoding — critique M6). */
const refusals = [
  'We do not take undisclosed factory commissions.',
  'We do not promise filming access we have not confirmed.',
  'We do not route you to trade companies posing as factories.',
];

const faqs = [
  {
    q: 'Can I actually film inside a Chinese factory?',
    a: [
      'Often yes, but it depends on the factory, the category and the city. Some factories welcome creators, some allow filming only with approval, and a few decline. We confirm what is realistic before you book a flight — we do not sell a route we cannot film.',
    ],
  },
  {
    q: 'How do I know the factory is real and not a trade company?',
    a: [
      'We check the business licence and registered scope, match it to what they claim to make, and confirm the production floor exists. Our verification process is documented step by step so you can see exactly what was checked.',
    ],
  },
  {
    q: 'Do you take hidden commissions from factories?',
    a: [
      'No. Our pricing is two visible lines: an escort and coordination fee, and an optional sourcing commission that we disclose in writing. We will show you the structure before you pay anything.',
    ],
  },
  {
    q: 'When should I avoid travelling to China for factory visits?',
    a: [
      'Chinese New Year and National Day week shut most factories for one to three weeks. We plan around the holiday calendar so you do not fly 20 hours to an empty floor.',
    ],
  },
];

/* NO hand-written FAQPage JSON-LD here.
   <FAQ> already emits one, built from the same `faqs` array just below
   (FAQ.astro:29) — so a second, hand-built copy could only ever agree with it
   by luck, and Google discounts rich-result confidence when one page publishes
   the same FAQPage twice. If this page ever needs to publish a COMBINED graph
   (several FAQ groups as one entity), pass schema={false} to <FAQ> and build
   the single block here — see src/pages/faq/index.astro for that pattern. */
---
<BaseLayout
  title="Visit Real Chinese Factories — With Someone On The Ground | ChinaFactoryHost"
  description="Factory tours for creators and verified sourcing visits for brands. We vet the factory, plan the route and stay with you on the floor."
  active=""
  bodyClass="over-hero"
  cta={{
    title: 'Tell us what you need to see on the floor.',
    lead: 'We will tell you honestly whether it is realistic, what it costs and when to come, before you book anything.',
    primary: { label: 'Start the conversation', href: '/contact/' },
    micro: REPLY_TIME_MICRO,
  }}
>
  {/* ── hero-full-bleed (§5.4) ───────────────────────────────────────────────
      The only real photograph on the site. DOM order is img → .scrim → .content,
      which is required for object-position to survive (§8.3) — a CSS
      background-image would throw away alt, loading and width/height.
      --over-hero is enabled only here, because this is the only page with a
      full-bleed photograph. */}
  <section class="hero-full">
    <div class="hero-full__media" aria-hidden="true">
      {/* AVIF → WebP → JPEG. Generated by the media pass (another worker) as
          public/images/hero-800.{avif,webp,jpg} + hero-1600.{avif,webp,jpg} —
          same photograph, two widths. width/height stay on the fallback <img>
          so the aspect ratio reserves its box before any candidate decodes
          (CLS), and fetchpriority stays on the LCP element. */}
      <picture>
        <source
          type="image/avif"
          srcset="/images/hero-800.avif 800w, /images/hero-1600.avif 1600w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/hero-800.webp 800w, /images/hero-1600.webp 1600w"
          sizes="100vw"
        />
        <img
          src="/images/hero-1600.jpg"
          srcset="/images/hero-800.jpg 800w, /images/hero-1600.jpg 1600w"
          sizes="100vw"
          alt=""
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <div class="hero-full__scrim" aria-hidden="true"></div>
    <div class="hero-full__scrim-top" aria-hidden="true"></div>

    <div class="hero-full__content">
      <div class="container">
        {/* §6.6 hero budget: exactly one button and one text link.
            B1 — the three lines enter as one gesture, staggered 120ms apart
            (delay is read by components.css from --reveal-delay). Nothing here
            is hidden without JS: base.css only applies the hidden start state
            under .js, and prefers-reduced-motion resets it (base.css:127-135). */}
        {/* "China" is load-bearing: without it a visitor arriving cold from search
            or a shared link cannot tell what country this service is in. */}
        <h1 data-reveal style="--reveal-delay: 0ms">Walk the real China factory floor.<br />Not a trade&#8209;company showroom.</h1>
        <p class="hero-full__lead" data-reveal style="--reveal-delay: 120ms">
          We vet the factory, plan the route and stay beside you on the floor. Filming for an
          audience of millions, or signing your first production run.
        </p>

        <div class="hero-full__actions" data-reveal style="--reveal-delay: 240ms">
          {/* B3 — the weighting was inverted. Brand sourcing is the higher-ticket
              route (Brief §1.1) and it was the TEXT LINK, while the creator
              route held the only filled button. Now: solid primary for the
              buyer route, lightweight link-arrow for the creator route — which
              also matches the "creator pages make light promises" rule. */}
          <a class="btn btn--primary" href="/services/brand-sourcing-visit/">Plan my sourcing visit</a>
          <a class="link-arrow" href="/services/creator-factory-tour/">
            Check if your shoot is feasible
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── claims strip ─────────────────────────────────────────────────────────
      Moved OFF the photograph. At --fs-body-sm on the image these three read as
      a footnote; as their own band they carry real weight and soften the hard
      photo-to-surface edge. Still number-free on purpose. */}
  <section class="claims-strip">
    <div class="container">
      <ul class="claims-strip__inner">
        {
          heroClaims.map((c) => (
            <li class="claims-strip__item">
              <Icon name="check" size={20} />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── trust bar — evidence, not adjectives ────────────────────────────────
      The homepage was a list of ARGUMENTS with nothing to point at. TrustBar
      (§5.4) was built for exactly this and referenced nowhere.

      Evidence gate (§11.1 #4): every figure below is derived from a constant
      that renders elsewhere on the same site, so none of them can be invented
      here — change the vetting page and this line changes with it:
        · VET_STEPS.length      → the five checks (how-we-vet-factories/)
        · FILMING_LEAD_TIME_DAYS → site.ts §Filming lead time (also shenzhen/,
                                   contact/)
        · '00' is the "no commission" commitment the page already makes below,
          where it is written out in full. Nothing here asserts a count of
          factories, clients or trips — we cannot audit those.
      `light` (not the inverse variant) because the hero and the closing CTA
      already use this page's two dark bands (§4.1.8: ≤2 per page).
      Components do not forward undeclared attributes, so this one carries no
      data-reveal — it sits directly under the hero, already above the fold. */}
  <TrustBar
    light
    items={[
      {
        figure: String(VET_STEPS.length).padStart(2, '0'),
        label: 'Checks on every factory',
      },
      {
        figure: String(FILMING_LEAD_TIME_DAYS).padStart(2, '0'),
        label: 'Working days of filming-permission lead time',
      },
      { figure: '00', label: 'Commission taken from factories' },
    ]}
    foot="These are counts of steps and lead times we publish elsewhere on this site — every one of them links to the page that shows the work. We do not publish “factories verified” or “clients served” totals, because we cannot audit them."
  />

  {/* ── audience splitter ──────────────────────────────────────────────────── */}
  <Section>
    <div class="container" data-reveal>
      <SectionHead
        eyebrow="Two routes"
        title="Two ways to use us. One standard of proof."
        lead="Both routes start in the same place: a factory we have actually checked, and a plan that says what happens on which day."
      />
      <div class="splitter__grid">
        <article class="split-card split-card--creator" data-track="creator" data-reveal style="--reveal-delay: 80ms">
          <span class="split-card__icon"><Icon name="camera" size={32} /></span>
          <h3 class="split-card__title">Factory tours built for the camera</h3>
          <p class="split-card__desc">
            Join a group departure or run a private crew route through the clusters that matter to
            your niche.
          </p>
          <ul class="split-card__bullets">
            {
              creatorPoints.map((p) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="split-card__cta">
            <a class="link-arrow" href="/services/creator-factory-tour/">
              Check if your shoot is feasible
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </article>

        <article class="split-card split-card--buyer" data-track="buyer" data-reveal style="--reveal-delay: 160ms">
          <span class="split-card__icon"><Icon name="clipboard" size={32} /></span>
          <h3 class="split-card__title">Sourcing visits that respect your time</h3>
          <p class="split-card__desc">
            Custom itineraries for Amazon sellers, DTC founders and procurement teams flying in for
            a week.
          </p>
          <ul class="split-card__bullets">
            {
              buyerPoints.map((p) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="split-card__cta">
            <a class="link-arrow" href="/services/brand-sourcing-visit/">
              Request a sourcing visit plan
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </article>
      </div>
    </div>
  </Section>

  {/* ── what we do — LIST, not a third card grid (H2) ────────────────────────
      This page ran three consecutive card grids (split cards → service cards →
      four claim cards), identical grammar to the pixel: white fill, hairline,
      14px radius, icon, link — which reads as one template stamped three times.
      .service-list drops the shell here: no fill, no border box, no radius; rows
      are separated by a single divider rule and the icon sits inline with the
      text. The two card grids either side keep their shells, so the eye gets
      density contrast instead of repetition. (styles live in components.css
      §9 — remove the class and the cards come back verbatim.) */}
  <Section alternate>
    <div class="container">
      <SectionHead
        eyebrow="Services"
        title="One team, on the ground, end to end"
        lead="Everything that happens between “I have an idea” and “I am standing on the production floor”."
      />
      <div class="grid--3 service-list">
        {
          services.map((s, i) => (
            <ServiceCard
              title={s.title}
              desc={s.desc}
              icon={s.icon}
              href={s.href}
              cta={s.cta}
              reveal={i * 80}
            />
          ))
        }
      </div>
    </div>
  </Section>

  {/* ── numbered process ───────────────────────────────────────────────────── */}
  <Section>
    <div class="container" data-reveal>
      <SectionHead
        eyebrow="Process"
        title="Four steps from idea to factory floor"
        lead="No mystery, and no “we'll figure it out when you land”. This is the same process for every client."
      />
      <ProcessSteps items={steps} layout="grid" />
    </div>
  </Section>

  {/* ── why us: four claims, four landing pages (§1.1 #6) ──────────────────── */}
  <Section alternate>
    <div class="container" data-reveal>
      <SectionHead
        eyebrow="Proof"
        title="Why teams bring us onto the floor"
        lead="Each of these is someone else's job to prove. Ours is to show you where we checked."
      />
      <div class="grid--2">
        {
          whyUs.map((w, i) => (
            <article class="split-card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="split-card__icon"><Icon name={w.icon} size={32} /></span>
              <h3 class="split-card__title">{w.title}</h3>
              <p class="split-card__desc">{w.desc}</p>
              <p class="split-card__cta">
                <a class="link-arrow" href={w.href}>
                  {w.cta}
                  <Icon name="arrow" size={14} />
                </a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  {/* ── what it costs to do it yourself (CostComparison §5.7) ───────────────
      Second piece of evidence the page was missing: not a claim, but the two
      working methods side by side, so the reader can audit the difference.

      No prices anywhere. The two monetary slots resolve to "—" because we have
      no published figures, and inventing a number here would break the one rule
      that makes the rest of the page believable. The footnote states what we
      CAN put in writing — the two-line fee structure already described in the
      FAQ below, word for word. Rows tagged `hidden` are the costs that do not
      appear on any quote but always get paid. */}
  <Section>
    <div class="container">
      <SectionHead
        eyebrow="Straight numbers"
        title="Self-organised vs hosted: where the week actually goes"
        lead="The same visit, planned two ways. Every row below is a task someone has to do before you are standing on the floor — this is who does it."
      />
      <div data-reveal>
        <CostComparison
          rows={costRows}
          caption="Comparison of a self-organised factory visit against a hosted one: who does each task, and what each option costs."
          footnote="We do not publish figures yet — every trip is scoped per category, city and dates, so any number here would be a guess. What we can put in writing before you pay: an escort and coordination fee, and an optional sourcing commission we disclose. No commission is taken from the factory."
        />
      </div>
    </div>
  </Section>

  {/* ── coverage ───────────────────────────────────────────────────────────── */}
  <Section>
    <div class="container" data-reveal>
      <SectionHead
        eyebrow="Coverage"
        title="Coverage across China's industrial clusters"
        lead="Based in Zhejiang, with a regular presence in the Pearl River Delta. Reachable almost everywhere else."
      />
      <div class="related-nav" role="navigation" aria-label="Destinations">
        {
          destinations.map((d) => (
            <a href={d.href}>
              <span class="related-nav__k">{d.k}</span>
              <span class="related-nav__t">{d.t}</span>
            </a>
          ))
        }
      </div>
    </div>
  </Section>

  {/* ── what we will not do ────────────────────────────────────────────────── */}
  <Section alternate>
    <div class="container" data-reveal>
      <div class="split-7-5">
        <SectionHead
          eyebrow="Straight talk"
          title="What we will not do"
          lead="Straight talk, because you are about to spend real money and twenty hours on a plane."
        />
        <Checklist items={refusals} plain refusal />
      </div>
    </div>
  </Section>

  {/* ── FAQ ────────────────────────────────────────────────────────────────── */}
  <Section tight>
    <div class="container" data-reveal>
      <SectionHead eyebrow="Questions" title="The questions everyone asks first" />
      <FAQ items={faqs} />
    </div>
  </Section>
</BaseLayout>
