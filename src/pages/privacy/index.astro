---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import Checklist from '../../components/Checklist.astro';
import Caveat from '../../components/Caveat.astro';

/* Keep this policy aligned with form delivery and optional analytics. */

const title = "Privacy and Service Disclaimer";
const description =
  'How we handle inquiries, optional analytics cookies, and your privacy choices.';
---

<BaseLayout
  title={title}
  description={description}
  track="neutral"
  current="Privacy & disclaimer"
  cta={{
    /* Long-form / legal pages must not use dark bands — design system §4.1.8 */
    variant: 'plain',
    title: 'Questions about any of this?',
    lead: 'Ask us directly. If you want your details deleted, say so in one line and we will do it.',
    primary: { label: 'Contact us', href: '/contact/' },
  }}
>
  <section class="hero">
    <div class="container container--md">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy and Service Disclaimer</h1>
      <p class="lead hero__lead">
        We use the details you submit to respond to your inquiry. When enabled, optional Google Analytics helps us understand visits and successful inquiries, only after you allow it.
      </p>
    </div>
  </section>

  <!-- 1 · What we collect -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="The short version"
        title="What we collect."
        lead="Only what the form asks for, plus two things that are added automatically."
      />
      <Checklist
        items={[
          'Your name and your email address',
          'Your WhatsApp number — only if you choose to fill the field, it is optional',
          'What you are trying to do, in your own words',
          'Which page you sent the form from, so we know what you were reading',
          'The page and contact-link position that brought you to the form, when available; this context is included in your inquiry email',
          'Your IP address, used for nothing except slowing down automated abuse',
        ]}
      />
    </div>
  </Section>

  <!-- 2 · Where it goes -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead
        eyebrow="Handling"
        title="Where it goes, and how long it stays."
      />
      <p>
        We use Resend to deliver your submission as an email to our mailbox. The delivery provider
        processes the contact details and message needed to send that email. We do not run a customer
        database on this site — the email <em>is</em> the record.
      </p>
      <p>
        We keep it for as long as we need to answer you and, if a trip comes out of it, to run that
        trip. If you want it gone, ask us on the contact page and we will delete it. There is no
        retention schedule more complicated than that, and we would rather say so than publish one
        we do not follow.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead title="Optional analytics." />
      <p>When configured, we use Google Analytics 4 to measure page visits, successful inquiries and contact-link clicks. Google receives technical and usage data, and analytics cookies can distinguish visits. Advertising personalization and Google signals are disabled in our tag.</p>
      <p>The Google tag loads only after you choose Allow analytics. Declining does not affect forms or tools. We store your preference in this browser for up to 180 days. Use Analytics preferences in the footer to change it. Withdrawing consent stops future collection and removes this site's Google Analytics cookies; it does not erase previously collected data.</p>
      <p>Our custom events exclude names, email addresses and messages. Page URLs are sent without query strings or fragments. Hosting and security providers may separately process request logs to operate the site. See <a href="https://policies.google.com/privacy">Google’s privacy policy</a> for its data handling.</p>
    </div>
  </Section>

  <!-- 3 · What we do not do -->
  <Section>
    <div class="container container--md">
      <SectionHead
        eyebrow="Refusals"
        title="What we do not do."
        lead="Listed as refusals rather than promises, because these are things we have chosen not to build."
      />
      <Checklist
        refusal
        items={[
          'No names, email addresses or inquiry messages sent through our analytics events',

          'No advertising or remarketing pixel',
          'No third-party social embed',
          'We do not sell or rent your details; our email delivery provider processes submissions to deliver them',
          'We do not add you to a mailing list — we do not run one',
        ]}
      />
    </div>
  </Section>

  <!-- 4 · The download -->
  <Section alternate>
    <div class="container container--md">
      <SectionHead
        eyebrow="The checklist"
        title="What the download costs you."
      />
      <p>
        If you submit the checklist form, we receive the email address you typed. The PDF is
        available on the page, including if delivery fails or JavaScript is disabled. We do not
        email the file or send follow-up messages unless you ask us to.
      </p>
    </div>
  </Section>

  <!-- 5 · Disclaimer -->
  <Section>
    <div class="container container--md">
      <Caveat
        title="What this site is not"
        body="Two things on this site are easy to misread, so they are stated here as plainly as we can manage."
        items={[
          'The vetting method we publish is a documented process, not a certification. We are not a certification body and issue no certificates.',
          'The write-ups under Case studies are samples. They show the structure and level of detail of the report you receive — they are not records of trips we have already run.',
          'Nothing on this site is legal advice, and describing how we handle your details here is not a substitute for a policy written by a lawyer.',
        ]}
      />
    </div>
  </Section>
</BaseLayout>
