---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import OnsitePhoto from '../../../components/OnsitePhoto.astro';
import Checklist from '../../../components/Checklist.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import Caveat from '../../../components/Caveat.astro';
import FAQ from '../../../components/FAQ.astro';
import Icon from '../../../components/Icon.astro';
import RelatedNav from '../../../components/RelatedNav.astro';
import { waLink } from '../../../data/site.ts';

const title = "Find Manufacturers in China: Shortlisting for Factory Visits";
const description = "Find manufacturers in China for your product. We identify sourcing regions, screen candidates and prepare a shortlist for factory visits.";

const wa = waLink('Hi, I need help finding factories for my product in China.');

const steps = [
  { n: '01', title: 'Define the spec', body: 'Product, material, quantity, target quality and the certifications your market requires. A spec that is vague produces a shortlist that is vague.', evidence: ['Product and material locked down', 'Quantity, annual and per order, stated', 'Certification requirements named'] },
  { n: '02', title: 'Name the cluster', body: 'Identify regions with relevant suppliers and processes, then plan travel around the shortlist.', evidence: ['Category matched to the right cluster', 'The reasoning explained, not just the name'] },
  { n: '03', title: 'Build and pre-screen the pool', body: 'A candidate pool wider than what you need, cut down with the five checks. We record which checks have been completed and what needs confirmation.', evidence: ['Licence and scope checked', 'Address and capacity verified', 'The failures removed and documented'] },
  { n: '04', title: 'Hand over the shortlist', body: 'The survivors, arranged for visiting, with the reason each one made it. Then the visit does the work the shortlist prepared for.', evidence: ['Supplier details and checks to follow up', 'Each entry tied to the check that passed'] },
];

const needFromYou = [
  { k: 'Product and material', v: 'What it is and what it is made of. Material is the second filter after category.' },
  { k: 'Quantity', v: 'Annual and per order, stated separately — suppliers price them differently.' },
  { k: 'Target price', v: 'A number, so the factory knows whether it is in the running.' },
  { k: 'Destination market', v: 'Which market, because the certification requirements follow from it.' },
  { k: 'Custom or stock', v: 'A stock shape you can buy is a market order; a custom mould is a tooling order.' },
];

const scoring = [
  { k: 'Cluster fit', v: 'Is the factory in the cluster that makes your category, or is it a generalist claiming to?' },
  { k: 'Capacity match', v: 'Can it support your order volume and production schedule?' },
  { k: 'Certification match', v: 'Does it already hold the certificates your market requires?' },
  { k: 'MOQ fit', v: 'What minimum applies to your specification, and can the supplier accept your order?' },
];

const faqs = [
  { q: 'I do not know which city makes my product.', a: ['That is the most common starting point. Tell us the category and quantity, and we name the cluster — and explain why it is that city and not the one with the better airport.'] },
  { q: 'How is matching different from a visit?', a: ['Matching produces the shortlist. The visit is what you do with it. Most people want both, in that order.'] },
  { q: 'Do you take a cut from the factories you recommend?', a: ['No. We are paid by you, so a factory gets onto the shortlist because it fits your spec, not because it pays us to be there.'] },
  { q: 'How many factories will I end up with?', a: ['Enough to compare, not enough to waste a week. Usually three to five survivors, each tied to the check that passed — the number depends on your category, not a target we force.'] },
  { q: 'What if my category is too small or too niche?', a: ['We will say so, and point you at who serves it better. Matching a category we do not know is how we would hand you a bad shortlist, and we would rather not.'] },
  { q: 'Can you match me without me visiting?', a: ['We can build and pre-screen the shortlist remotely, but the verification is only as good as the floor. The shortlist prepares for the visit; it does not replace it.'] },
  { q: 'What if a matched factory does not respond?', a: ['We move down the shortlist. That is why it has more entries than you need — a silence does not stall the whole trip.'] },
  { q: 'Do you charge per factory matched?', a: ['No. We charge for the trip and the coordination, not per factory. The shortlist is not a lead list we sell; it is the plan for your visit.'] },
  { q: 'What is the difference between matching and vetting?', a: ['Matching finds the factories; vetting checks them. Both happen before you fly, but they answer different questions — where to go, versus whether the name is real.'] },
  { q: 'Do you work through agents or resellers?', a: ['We work for the buyer, directly. We do not take factory commissions, and we do not white-label our service through intermediaries.'] },
];
---

<BaseLayout
  title={title}
  description={description}
  active="services"
  crumbs={[{ href: '/services/', label: 'Services' }]}
  current="Factory matching"
  cta={{
    eyebrow: 'Next step',
    title: 'Tell us the product. We will name the cluster.',
    lead: 'Send your product, material and quantity to discuss a supplier shortlist.',
    primary: { label: 'Find my factories', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <section class="hero hero--centered">
    <div class="container">
      <div class="hero__center">
        <p class="eyebrow">Factory matching</p>
        <h1>Find Manufacturers in China: Shortlisting for Factory Visits</h1>
        <p class="lead hero__lead">
          We identify sourcing regions and screen candidate suppliers using your product, material and quantity requirements.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Find my factories</a>
          <a class="btn btn--secondary" href="/destinations/">See the clusters</a>
        </div>
      </div>
      <div class="hero__media hero__banner">
        <PhotoSlot name="MATCH · THE SHORTLIST" variant="strip">
          <OnsitePhoto id="04" sizes="(max-width: 720px) 100vw, 100vw" />
        </PhotoSlot>
      </div>
    </div>
  </section>

  <Section>
    <div class="container container--md">
      <SectionHead
        center
        eyebrow="The process"
        title="From spec to shortlist."
        lead="We use your product brief to identify sourcing regions, screen suppliers and prepare a shortlist for visits."
      />
      <ProcessSteps items={steps} />
      <p class="u-mt-6">
        The cluster is named by the <a href="/tools/china-manufacturing-hub-finder/">manufacturing hub finder</a>, and the checks are the same{' '}
        <a href="/about/how-we-vet-factories/">five vetting checks</a> run on every factory.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="What we need" title="The inputs that make the shortlist real." />
      <ul class="spec-list clean spec-list--split">
        {needFromYou.map((n) => (
          <li>
            <span class="spec-list__k">{n.k}</span><span class="spec-list__v">{n.v}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead center eyebrow="How we score" title="What puts a factory on the shortlist." />
      <ul class="soft-grid clean">
        {scoring.map((s) => (
          <li>
            <p class="soft-grid__k">{s.k}</p>
            <p class="soft-grid__v">{s.v}</p>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        <a class="link-arrow" href="/tools/factory-visit-scorecard/">
          See the full six-dimension scorecard
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="Worked through" title="Three products, three matches." />
      <ul class="soft-grid soft-grid--three clean">
        <li>
          <p class="soft-grid__k">A 30ml serum bottle, private label, 5,000 units</p>
          <p class="soft-grid__v"><a href="/destinations/guangzhou-dongguan/">Guangzhou / Dongguan</a>. The packaging supplier and the filling plant are two companies there, and the cluster puts them close together.</p>
        </li>
        <li>
          <p class="soft-grid__k">A custom injection-moulded toy, 10,000 units</p>
          <p class="soft-grid__v"><a href="/destinations/guangzhou-dongguan/">Dongguan</a> or Shantou. The tooling and the injection capacity sit in the toy cluster, and the MOQ is set by the mould.</p>
        </li>
        <li>
          <p class="soft-grid__k">Five hundred stock kitchen gadgets</p>
          <p class="soft-grid__v"><a href="/destinations/yiwu/">Yiwu</a>. A stock shape at low quantity is a market order, and Yiwu is built around that.</p>
        </li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead center eyebrow="The three stages" title="Matching, a visit and a full trip are different things." />
      <ul class="soft-grid soft-grid--three clean">
        <li>
          <p class="soft-grid__k">Matching</p>
          <p class="soft-grid__v">Produces the shortlist — spec-driven and largely remote.</p>
        </li>
        <li>
          <p class="soft-grid__k">A visit</p>
          <p class="soft-grid__v">Verifies the shortlist on the floor, as in an <a href="/services/existing-supplier-visits/">existing-supplier visit</a>.</p>
        </li>
        <li>
          <p class="soft-grid__k">A full trip</p>
          <p class="soft-grid__v">Matching plus visiting plus <a href="/china-sourcing-trips/">the follow-through</a>, in one booking.</p>
        </li>
      </ul>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="How long" title="How long matching takes." />
      <ul class="spec-list clean spec-list--split">
        <li><span class="spec-list__k">It depends on the category</span><span class="spec-list__v">A well-documented category moves faster than an unusual one.</span></li>
        <li><span class="spec-list__k">It depends on the checks</span><span class="spec-list__v">Registration checks are quick; capacity and floor checks need a visit.</span></li>
        <li><span class="spec-list__k">We will give you a window</span><span class="spec-list__v">Not a promise we cannot keep — a realistic window for your specific category.</span></li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <Caveat
        title="What matching does not do"
        body="We shortlist and verify. We do not pretend a desk search is a factory visit."
        items={[
          'We do not hand you an un-vetted spreadsheet and call it a shortlist.',
          'We do not guarantee a factory will accept your order — we get you to the right doors, then the visit does the work.',
          'We do not build remote supplier lists for a flat fee and call it sourcing. Matching is the front half of a trip, not a substitute for one.',
        ]}
      />
    </div>
  </Section>

  <Section>
    <div class="container">
      <SectionHead center title="Questions about finding factories." />
      <FAQ items={faqs} />
    </div>
  </Section>

  <Section alternate>
    <div class="container">
      <SectionHead center eyebrow="Where next" title="Related pages." />
      <RelatedNav
        items={[
          { k: 'Tool', t: 'Manufacturing hub finder', href: '/tools/china-manufacturing-hub-finder/' },
          { k: 'Page', t: 'All destinations', href: '/destinations/' },
          { k: 'Service', t: 'Visit existing suppliers', href: '/services/existing-supplier-visits/' },
          { k: 'Plan', t: 'Plan my trip', href: '/plan-my-trip/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>

<style>
  /* wps.com layout grammar (docs/visual-grammar-wps.md), page-scoped. */

  .hero__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .hero__center :global(.eyebrow) { justify-content: center; }
  .hero__center :global(h1) { max-width: 15em; }
  .hero__center :global(.hero__lead) {
    font-size: var(--fs-h4);
    line-height: 1.5;
    max-width: 34em;
  }
  .hero__banner {
    max-width: none;
    margin-top: var(--space-12);
  }

  :global(.section:not(.section--tight)) {
    padding-block: calc(var(--section-py) * 1.3);
  }

  /* Borderless soft blocks: sunken on white bands, white on grey bands. */
  .soft-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }
  .soft-grid li {
    background: var(--surface-sunken);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
  }
  .soft-grid__k {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }
  .soft-grid__v {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-body-sm);
    color: var(--text-secondary);
  }
  @media (min-width: 768px) {
    .soft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
    .soft-grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  :global(.section--alternate) .soft-grid li {
    background: var(--color-surface);
  }
</style>
