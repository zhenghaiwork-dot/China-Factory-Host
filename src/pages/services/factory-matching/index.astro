---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import OnsitePhoto from '../../../components/OnsitePhoto.astro';
import Checklist from '../../../components/Checklist.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import Caveat from '../../../components/Caveat.astro';
import FAQ from '../../../components/FAQ.astro';
import Icon from '../../../components/Icon.astro';
import RelatedNav from '../../../components/RelatedNav.astro';
import { waLink } from '../../../data/site.ts';

const title = "Find Manufacturers in China for Your Product";
const description = "Find manufacturers in China that fit your product, order size and target market. Get supplier screening and a shortlist to plan factory visits.";

const wa = waLink('Hi, I need help finding factories for my product in China.');

const steps = [
  {
    "n": "01",
    "title": "Start with your product brief",
    "body": "Share a product link, photos or drawings, materials, order quantity and destination market. We identify missing details before contacting suppliers.",
    "evidence": [
      "Product and manufacturing process",
      "Initial order size and customization",
      "Target market and required documents"
    ]
  },
  {
    "n": "02",
    "title": "Identify relevant suppliers and regions",
    "body": "Narrow the search by product and production process. Compare potential manufacturing locations before deciding where to travel.",
    "evidence": [
      "Candidate suppliers and locations",
      "Reasons each region may fit your product"
    ]
  },
  {
    "n": "03",
    "title": "Screen candidates against your requirements",
    "body": "Review company identity, product scope and the evidence suppliers provide. Separate supplier claims from completed checks, and flag what needs a sample, site visit or specialist review.",
    "evidence": [
      "Company and production-site information",
      "Supplier-stated MOQ and capacity",
      "Missing evidence and follow-up questions"
    ]
  },
  {
    "n": "04",
    "title": "Prepare a shortlist and next steps",
    "body": "Compare suitable candidates, explain outstanding questions and agree which suppliers are worth contacting or visiting. Appointments depend on supplier confirmation.",
    "evidence": [
      "Reasons to include each candidate",
      "Open questions and suggested next steps"
    ]
  }
];

const needFromYou = [
  {
    "k": "Product reference",
    "v": "A product link, photos, sample or drawing, with material and dimensions where known."
  },
  {
    "k": "Order quantity",
    "v": "Your first order quantity and likely repeat orders. An estimate is useful if demand is not yet confirmed."
  },
  {
    "k": "Budget or target price",
    "v": "Share a range if you have one, and say whether it includes packaging or shipping. It is fine to ask for a feasibility check first."
  },
  {
    "k": "Destination market",
    "v": "Where you will sell the product and any testing or compliance requirements already identified."
  },
  {
    "k": "Customization",
    "v": "Existing design, private label or new tooling? Note the changes you need and your preferred launch date."
  }
];

const scoring = [
  {
    "k": "Product and process fit",
    "v": "Does the supplier make this type of product, and which production steps are in-house or subcontracted?"
  },
  {
    "k": "Order size and timing",
    "v": "Does the supplier’s stated MOQ and availability fit your initial order? Capacity and dates need evidence and confirmation."
  },
  {
    "k": "Documents and open checks",
    "v": "Do available reports relate to the correct company, product model and target market? Specialist compliance review may still be needed."
  },
  {
    "k": "Commercial fit",
    "v": "Compare customization, tooling, sample terms and quote scope rather than unit price alone."
  }
];

const faqs = [
  {
    "q": "How do I find a manufacturer in China for my product?",
    "a": [
      "Start with a product brief, then identify suppliers by product and manufacturing process. Compare their company details, order requirements and evidence before requesting samples or arranging visits. This service helps prepare that shortlist."
    ]
  },
  {
    "q": "Can you check suppliers I found on Alibaba or at a trade fair?",
    "a": [
      "Send their company names, profile links, quotes and contact details with your product brief. We can discuss screening your existing candidates instead of starting a new search. For an established shortlist, see our existing-supplier visit service."
    ]
  },
  {
    "q": "Can you help with a small order or low MOQ?",
    "a": [
      "Share your actual first-order quantity. Stock products and existing tooling may offer different options from a custom design, but no minimum quantity can be promised before suppliers review your specification."
    ]
  },
  {
    "q": "How do you distinguish a factory from a trading company?",
    "a": [
      "Review the legal entity, production address, product scope and evidence of relevant processes. A business licence or platform badge alone does not establish who makes the product. Record subcontracting and arrange further checks where the evidence is incomplete."
    ]
  },
  {
    "q": "What do I receive from supplier matching?",
    "a": [
      "The agreed shortlist includes candidate details, reasons for selection, screening status and questions to resolve before sampling or visiting. We confirm the scope and expected number of candidates with your project brief rather than promise a fixed number for every category."
    ]
  },
  {
    "q": "Do I have to visit China?",
    "a": [
      "Initial supplier research and document review can be handled remotely. A visit can help examine the production site and discuss technical questions, but neither a shortlist nor a visit replaces product testing or a specialist audit when required."
    ]
  },
  {
    "q": "How much does supplier matching cost, and how long does it take?",
    "a": [
      "Send your product brief and any existing candidates so we can confirm scope, fees and a schedule before you proceed. Supplier response times, customization and the checks required affect the work. Sampling, travel and specialist testing should be clarified separately."
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  active="services"
  crumbs={[{ href: '/services/', label: 'Services' }]}
  current="Factory matching"
  cta={{
    eyebrow: 'Next step',
    title: 'Start with your product and order size.',
    lead: 'Send a product link, photos or drawings, your first-order quantity and target market. We will review whether we can help and confirm the proposed scope.',
    primary: { label: 'Discuss my supplier shortlist', href: '/contact/' },
    secondary: { label: 'Ask on WhatsApp', href: wa, external: true },
  }}
>
  <section class="hero hero--centered">
    <div class="container">
      <div class="hero__center">
        <p class="eyebrow">Factory matching</p>
        <h1>Find Manufacturers in China for Your Product</h1>
        <p class="lead hero__lead">
          Need suppliers for a new product, or a second opinion on names you already have? We help identify relevant manufacturers, screen candidates and prepare a shortlist for sampling or factory visits.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Discuss my supplier shortlist</a>
          <a class="btn btn--secondary" href="/destinations/">See the clusters</a>
        </div>
      </div>
      <div class="hero__media hero__banner">
        <PhotoSlot name="MATCH · THE SHORTLIST" variant="strip">
          <OnsitePhoto id="04" sizes="(max-width: 720px) 100vw, 100vw" />
        </PhotoSlot>
      </div>
    </div>
  </section>

  <Section>
    <div class="container container--md">
      <SectionHead
        center
        eyebrow="The process"
        title="From spec to shortlist."
        lead="We use your product brief to identify sourcing regions, screen suppliers and prepare a shortlist for visits."
      />
      <ProcessSteps items={steps} />
      <p class="u-mt-6">
        Use the <a href="/tools/china-manufacturing-hub-finder/">manufacturing hub finder</a> to explore possible regions, then review our <a href="/about/how-we-vet-factories/">supplier screening method</a>. Suppliers you meet at <a href="/china-trade-fairs/">trade fairs in China</a> can also be starting points for a shortlist.
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="What we need" title="What to send us to get started." />
      <ul class="spec-list clean spec-list--split">
        {needFromYou.map((n) => (
          <li>
            <span class="spec-list__k">{n.k}</span><span class="spec-list__v">{n.v}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead center eyebrow="How we score" title="How we compare potential suppliers." />
      <ul class="soft-grid clean">
        {scoring.map((s) => (
          <li>
            <p class="soft-grid__k">{s.k}</p>
            <p class="soft-grid__v">{s.v}</p>
          </li>
        ))}
      </ul>
      <p class="u-mt-6">
        <a class="link-arrow" href="/tools/factory-visit-scorecard/">
          See the full six-dimension scorecard
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="Deliverable" title="A shortlist you can compare." lead="Agree the scope before work starts. Each candidate should show what is known and what still needs checking." />
      <Checklist items={[
        'Company name, location and available contact details',
        'Relevant products and production processes, with the source of the information',
        'Supplier-stated MOQ, sample and customization terms where available',
        'Completed screening checks, missing documents and unresolved questions',
        'Suggested next steps: clarification, sample request or a factory visit',
      ]} />
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <SectionHead center eyebrow="The three stages" title="Matching, a visit and a full trip are different things." />
      <ul class="soft-grid soft-grid--three clean">
        <li>
          <p class="soft-grid__k">Matching</p>
          <p class="soft-grid__v">Finds and compares candidates against your product requirements.</p>
        </li>
        <li>
          <p class="soft-grid__k">A visit</p>
          <p class="soft-grid__v">Examines the site and follows up on production questions, as in an <a href="/services/existing-supplier-visits/">existing-supplier visit</a>.</p>
        </li>
        <li>
          <p class="soft-grid__k">A full trip</p>
          <p class="soft-grid__v">Coordinates supplier appointments and travel around your shortlist. Discuss the scope of <a href="/china-sourcing-trips/">a sourcing trip</a> before booking.</p>
        </li>
      </ul>
    </div>
  </Section>

  <Section alternate>
    <div class="container container--md">
      <SectionHead center eyebrow="How long" title="How long matching takes." />
      <ul class="spec-list clean spec-list--split">
        <li><span class="spec-list__k">It depends on the category</span><span class="spec-list__v">A well-documented category moves faster than an unusual one.</span></li>
        <li><span class="spec-list__k">It depends on the checks</span><span class="spec-list__v">Public records, supplier responses, samples and on-site checks have different timelines.</span></li>
        <li><span class="spec-list__k">We will give you a window</span><span class="spec-list__v">We confirm the proposed schedule after reviewing your brief and the checks needed.</span></li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="container container--md">
      <Caveat
        title="What matching does not do"
        body="A shortlist supports your next decision. It is not a guarantee of supplier performance or product compliance."
        items={[
          'Completed checks and supplier-provided information are identified separately.',
          'Order acceptance, pricing, MOQ and production dates require supplier confirmation.',
          'Product testing, formal audits and shipment inspection are separate tasks; confirm what your project requires.',
        ]}
      />
    </div>
  </Section>

  <Section>
    <div class="container">
      <SectionHead center title="Questions about finding factories." />
      <FAQ items={faqs} />
    </div>
  </Section>

  <Section alternate>
    <div class="container">
      <SectionHead center eyebrow="Where next" title="Related pages." />
      <RelatedNav
        items={[
          { k: 'Tool', t: 'Manufacturing hub finder', href: '/tools/china-manufacturing-hub-finder/' },
          { k: 'Page', t: 'All destinations', href: '/destinations/' },
          { k: 'Service', t: 'Visit existing suppliers', href: '/services/existing-supplier-visits/' },
          { k: 'Plan', t: 'Plan my trip', href: '/plan-my-trip/' },
        ]}
      />
    </div>
  </Section>
</BaseLayout>

<style>
  /* wps.com layout grammar (docs/visual-grammar-wps.md), page-scoped. */

  .hero__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .hero__center :global(.eyebrow) { justify-content: center; }
  .hero__center :global(h1) { max-width: 15em; }
  .hero__center :global(.hero__lead) {
    font-size: var(--fs-h4);
    line-height: 1.5;
    max-width: 34em;
  }
  .hero__banner {
    max-width: none;
    margin-top: var(--space-12);
  }

  :global(.section:not(.section--tight)) {
    padding-block: calc(var(--section-py) * 1.3);
  }

  /* Borderless soft blocks: sunken on white bands, white on grey bands. */
  .soft-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }
  .soft-grid li {
    background: var(--surface-sunken);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
  }
  .soft-grid__k {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }
  .soft-grid__v {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-body-sm);
    color: var(--text-secondary);
  }
  @media (min-width: 768px) {
    .soft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
    .soft-grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  :global(.section--alternate) .soft-grid li {
    background: var(--color-surface);
  }
</style>
